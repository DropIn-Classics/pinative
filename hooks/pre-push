#!/bin/sh
# Installed with: git config core.hooksPath hooks  (once per clone).
# See AGENTS.md.

# every doskit commit a pushed commit points to must be on doskit's
# remote, or a clone cannot fetch it ("not our ref")
remote="$1"
zero=0000000000000000000000000000000000000000
[ -d doskit ] || exit 0
git -C doskit fetch -q origin || { echo "pre-push: cannot fetch doskit's origin" >&2; exit 1; }
bad=0
while read -r lref lsha rref rsha; do
    [ "$lsha" = $zero ] && continue
    if [ "$rsha" = $zero ]; then
        range="$lsha --not --remotes=$remote"
    else
        range="$rsha..$lsha"
    fi
    for c in $(git rev-list $range -- doskit); do
        sub=$(git rev-parse -q --verify "$c:doskit") || continue
        if [ -z "$(git -C doskit branch -r --contains "$sub" 2>/dev/null)" ]; then
            echo "pre-push: $(git log -1 --format='%h %s' "$c")" >&2
            echo "  points to doskit $sub, which is not on doskit's origin" >&2
            bad=1
        fi
    done
done
[ $bad = 0 ] || { echo "push doskit first (git -C doskit push origin master)" >&2; exit 1; }
exit 0
