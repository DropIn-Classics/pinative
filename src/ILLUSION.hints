; ILLUSION.386, the main program: a pMAX flat image, unpacked from the
; archive in ILLUSION.EXE by tools/illfiles.py (extract --all).
pmax       build/files/ILLUSION.386
segment    CODE 0 CODE             ; descriptor 0: the whole image, code and data
segment    TAIL 1 BSS              ; descriptor 1: base at the image's end, size 0; its use not known

name       CODE:02A3 ENTRY         ; the header's entry point
comment    CODE:02C7 INT 93h AH=11h: presumably the command tail (DS:EDX); its first word goes to CODE:086C
comment    CODE:02FF INT 94h AH=8 with CX:EDX = CODE:086C: the configuration file (run 2026-09-29: "ILLUSION.CFG" as the argument is opened, created when missing; none: "Error while initializing configuration file")
comment    CODE:35B34 INT 2Fh AX=1510h, MSCDEX device request, the header copied to real-mode memory first
comment    CODE:35B52 INT 2Fh AX=1500h, MSCDEX installed? drive letter to CODE:3631B (no MSCDEX: "CD error!")
comment    CODE:35C58 IOCTL input: audio disk info, then track info for each track to CODE:35F1B (run with -cue: 0Ah, then 0Bh for tracks 1..51)
code       CODE:35B0D CD_REQUEST   ; EBX = a request header in the image, copied to real-mode memory for INT 2Fh AX=1510h
code       CODE:35C09 CD_VOLUME    ; IOCTL output (command 0Ch), BL to CODE:35EF8 and 35EFA: presumably the audio channel control's two volumes, not checked
name       CODE:35F1B CD_TRACK_START ; a dword a track, by its number (run: track 2's read at +8 when table 1 starts)
code       CODE:35DDC CD_PLAY      ; EBX = the track: the play request at CODE:35EA1 from its start to the next track's; ECX back = its length (run: "play frames 24470..38187 (track 2)" for EBX=2)
code       CODE:35E4F CD_STOP      ; the request at CODE:35E94 (command 85h, stop audio)
code       CODE:9D83 MUSIC_TRACK   ; stops the CD and plays track EBX; when bit 0 of CODE:CB97 is set, the length times [CCB8E] / 75 to CODE:9DBD, counted down at CODE:9CEA, which plays the track again at 0 (run, table 1: again after 159.3 s of a 182.9 s track, not explained)
comment    CODE:9BCA the table's first music record ([CODE:F470], header slot 35 of the table module): its word +8 the CD track, its byte +0Ah to CODE:CB97 (runs: tracks 2, 0Eh, 1Ah, 27h for tables 1..4, the byte 1 for all four)
comment    CODE:4FE8 plays track 33h (51) at the chooser's loading of infodata.mgl; not reached in runs up to t=126 (the chooser at t=7 plays no track)

; 16-bit addresses without a register (67h): no source form in a USE32
; segment, the assembler would write a 32-bit address
raw        CODE:0667
raw        CODE:0670
raw        CODE:0679
raw        CODE:068A
raw        CODE:2870
raw        CODE:A3C1
raw        CODE:27CA4              ; FS:[0] with 67h
raw        CODE:29044              ; ES:[0] with 67h
raw        CODE:30E49
raw        CODE:31D3D
raw        CODE:32A7C
raw        CODE:32A9D
raw        CODE:35B40
; FS before 66h (64 66 AD), where the assembler writes 66h first
raw        CODE:31649
; a DS prefix where DS is the default (3E), all three with EBP as the index
; register; 45 other such addresses have none
raw        CODE:13AD7
raw        CODE:141D6
raw        CODE:164B4

; two tables of 11 far pointers (DF, ended by FFFFFFFFh) the program hands
; to the sound driver (EDI=618Dh before the driver call at CODE:71E9,
; EDI=98FEh before the one at CODE:9B24): presumably the host callbacks of
; docs/audio-driver.md (not checked)
code       CODE:6244               ; far pointer 1 at CODE:618D
code       CODE:61ED               ; far pointer 2 at CODE:6193
code       CODE:6234               ; far pointer 3 at CODE:6199
code       CODE:626D               ; far pointer 4 at CODE:619F
code       CODE:627B               ; far pointer 5 at CODE:61A5
code       CODE:6280               ; far pointer 6 at CODE:61AB
code       CODE:6285               ; far pointer 7 at CODE:61B1
code       CODE:62EE               ; far pointer 8 at CODE:61B7
code       CODE:6318               ; far pointer 9 at CODE:61BD
code       CODE:632E               ; far pointer 10 at CODE:61C3
code       CODE:633F               ; far pointer 11 at CODE:61C9
code       CODE:99B5               ; far pointer 1 at CODE:98FE
code       CODE:995E               ; far pointer 2 at CODE:9904
code       CODE:99A5               ; far pointer 3 at CODE:990A
code       CODE:99DE               ; far pointer 4 at CODE:9910
code       CODE:99EC               ; far pointer 5 at CODE:9916
code       CODE:99F1               ; far pointer 6 at CODE:991C
code       CODE:99F6               ; far pointer 7 at CODE:9922
code       CODE:9A5F               ; far pointer 8 at CODE:9928
code       CODE:9A89               ; far pointer 9 at CODE:992E
code       CODE:9A9F               ; far pointer 10 at CODE:9934
code       CODE:9AB0               ; far pointer 11 at CODE:993A

; computed jumps (CODE:4CE8, CODE:4CF2, CODE:7438 and inline): a dword
; constant less the byte sum of a stretch of the image, presumably to make
; a changed program go astray. Worked out from the file's bytes; that
; nothing changes those bytes before the sum is taken is presumed.
; CODE:7AB6 sums 55E3h bytes from CODE:4CE8, through the far pointers
; start-up writes at CODE:A2BB..A2C6, and gets no address in the image
; from the file's bytes: left out.
code       CODE:236A               ; computed at CODE:503B: the dword at CODE:22DA less the sum of the 1158h bytes at CODE:448B
code       CODE:23CA               ; computed at CODE:4D5C: the dword at CODE:2322 less the sum of the DEh bytes at CODE:2613
code       CODE:24F8               ; computed at CODE:4DC7: the dword at CODE:232E less the sum of the 8Ch bytes at CODE:26F1
code       CODE:2503               ; computed at CODE:4DDC: the dword at CODE:233A less the sum of the 93h bytes at CODE:277D
code       CODE:26FD               ; computed at CODE:5009: the dword at CODE:22AA less the sum of the 8DDh bytes at CODE:4D06
code       CODE:2810               ; computed at CODE:4E06: the dword at CODE:2352 less the sum of the 360h bytes at CODE:28F5
code       CODE:28B8               ; computed at CODE:4E1B: the dword at CODE:2316 less the sum of the 164h bytes at CODE:24AF
code       CODE:28F5               ; computed at CODE:521C: the dword at CODE:2292 less the sum of the EFh bytes at CODE:50A9
code       CODE:33AC               ; computed at CODE:4E65: the dword at CODE:230A less the sum of the 126h bytes at CODE:2389
code       CODE:33B8               ; computed at CODE:4D41: the dword at CODE:22F2 less the sum of the 8DDh bytes at CODE:4D06
code       CODE:33F5               ; computed at CODE:5256: the dword at CODE:2286 less the sum of the 10h bytes at CODE:5130
code       CODE:38C6               ; computed at CODE:5057: the dword at CODE:22B6 less the sum of the 35Ah bytes at CODE:5289
code       CODE:39C8               ; computed at CODE:4E50: the dword at CODE:229E less the sum of the 58h bytes at CODE:5140
code       CODE:4CB6               ; computed at CODE:5026: the dword at CODE:22E6 less the sum of the 13Ch bytes at CODE:505C
code       CODE:698A               ; computed at CODE:78D9: the dword at CODE:908B less the sum of the 16F6h bytes at CODE:6A20
code       CODE:6E49               ; computed at CODE:795A: the dword at CODE:9043 less the sum of the 97h bytes at CODE:7341
code       CODE:6FC0               ; computed at CODE:78EE: the dword at CODE:9097 less the sum of the 16F6h bytes at CODE:6A20
code       CODE:7082               ; computed at CODE:75A2: the dword at CODE:9073 less the sum of the 16F6h bytes at CODE:6A20
code       CODE:72BB               ; computed at CODE:7A0F: the dword at CODE:907F less the sum of the 16F6h bytes at CODE:6A20
code       CODE:7341               ; computed at CODE:7895: the dword at CODE:904F less the sum of the 88Ch bytes at CODE:7230

; INT 93h AX=0, presumably pMAX's exit (not checked): what follows is data
; (CODE:BA9B writes the twelve bytes at CODE:BA83 to the DAC from colour FCh)
stop       CODE:BA81

; code reached through pointers
code       CODE:A39C               ; far jump at CODE:A396 through CODE:A2BB, with the selector INT 93h AH=8 gave at CODE:A381 for BX=CS (base presumably that of CODE: the code there uses CODE's variables; not checked)
words      CODE:BAD6 0A CODE       ; called at CODE:B993 by the number in CODE:CBCC while below 0Ah
words      CODE:910E 4 CODE        ; called at CODE:919D by the byte at CODE:00A2 (four pointers up to the code at CODE:911F)
words      CODE:27723 6 CODE       ; called by the word at [[CODE:0000]+4] (CODE:27833, 2786E, 278C2); six by the three parallel tables of data pointers after it (CODE:2773B, 27753, 2776B, 18h apart)
words      CODE:268FE 4 CODE       ; jumped to at CODE:26015 by the low two bits of EDI
words      CODE:26957 4 CODE       ; called at CODE:26946 by the byte at CODE:A311 less one (compared with 4 elsewhere; values 1..4 presumed)
words      CODE:26967 4 CODE       ; called at CODE:269AC, the same way
words      CODE:30D78 2 CODE       ; jumped to at CODE:30D76 by the word at [ESI+0Eh]; two pointers, zeros after them (the index range not checked)
; compiled switches: 16-bit offsets from the table (MOV reg,T[reg*2];
; LEA reg,[reg+T]; JMP/CALL reg); the index mostly the previous entry,
; kept in a dword at CODE:0020..0028. Counts from the bound check where there is one, else
; up to the smallest offset (the code right after the table)
rwords     CODE:1183F 20           ; CODE:117EB; index checked against 1Fh at CODE:117D9
rwords     CODE:11AE9 8            ; CODE:11A92, CODE:11AD0; index a byte ([[CODE:0000]+1]); eight, as 78h data words follow (CODE:11AF9, read at CODE:11A61 with an index below 78h) up to the first target
code       CODE:14DE2              ; MOV EBX,14DE2h; CALL EBX at CODE:298CA
rwords     CODE:13784 8            ; CODE:13725
rwords     CODE:2C3DD 5            ; CODE:2C2DF; the smallest offset is 32h, what lies from CODE:2C3E7 on is not checked
rwords     CODE:2C8BC 3            ; CODE:2C887
rwords     CODE:2F91C 2            ; CODE:2F903; index the complement of the word at CODE:0020
rwords     CODE:300B9 8            ; CODE:300A0; index the low three bits of a byte (CODE:30099)
rwords     CODE:308C7 2            ; CODE:308AD
code       CODE:A4A9               ; far jump at CODE:A4A3 through CODE:A2C1, with the selector saved from CS at CODE:A36A
code       CODE:4DB7               ; pushed at CODE:4D90 as the return address of the routine that ends in XCHG [ESP],EBX (CODE:4DB3); RET
words      CODE:29912 4 CODE       ; called in turn at CODE:298A7 through the pointer at CODE:2982E, which holds 29912h in the file; CODE:29873 (not reached yet) sets it to 29922h, a like table of four after this one
words      CODE:7AC0 0C0 CODE stride=8 ; records of 8 bytes from CODE:7ABC to 80BCh, a dword ascending (presumably a time) and a handler: CODE:704E calls [ESI+4] while [CODE:8124] reaches the first dword ([CODE:8128] set to 7ABCh at CODE:789A)
; two interpreters of word streams (the stream's word an index, 0 ends it):
; records of 4 bytes, a 16-bit offset from the table's second record and a
; number added to the stream's position; no bound check, the counts are up
; to the code after the table (its first offset)
rwords     CODE:2D18F 20 stride=4 from=2D193 ; LEA at CODE:2CF36 and CODE:2D148, call through CODE:2CF57 and CODE:2D169; record 0 leads to a RET
rwords     CODE:2F625 1A stride=4 from=2F625 ; LEA at CODE:2F4A4 and CODE:2F5A2, call through CODE:2F4C5 and CODE:2F5C4; record 0 at CODE:2F621 is 0,0 (index 0 not called)
words      CODE:2DA0A 1C CODE      ; PUSH [EBX*4+2DA0A] at CODE:2DA02 after PUSH 2DA09h, then RET: by the word at [[CODE:0008]+2Ch] (0 not taken); 28 up to the first target (a RET at CODE:2DA7A)
words      CODE:2CD10 0B CODE      ; its address put in [CODE:0010] (CODE:2BEDC, 2D04D, 2DBD3) before calls into the table module: its host vector (docs/bpc-module.md), the entries not checked one by one

; the keyboard (runs of 2026-09-29 with doskit's -rwatch on CODE:D984)
code       CODE:A076 KBD_IRQ       ; installed at CODE:A03B with INT 93h AH=4 BL=1 (presumably IRQ1's vector; the old one saved with AH=3); run: entered on each key event, CS=000C
ds         CODE:A08E-A10B CODE     ; DS from CODE:A10B (the selector made at CODE:A323 from DS); run: its writes land at CODE's addresses (KEY_DOWN below)
name       CODE:D984 KEY_DOWN     ; 256 bytes, FFh while the key is down: the scan code, +80h after an E0h prefix (run: +2Ah FFh on Left Shift down, 00h on its release)
name       CODE:DA84 KEY_TOGGLE    ; the same index, the byte inverted on each press
name       CODE:A016 LAST_KEY      ; the last scan code pressed (without 80h); also stored at CODE:CC2F
name       CODE:A01D KEY_E0        ; FFh after an E0h prefix
name       CODE:A2C7 KEY_RELEASED  ; FFh after a release: a press of Space (39h) or Alt (38h, E0 38h) counts only then (no typematic repeat for them, presumably)
; reads of KEY_DOWN through the record at [CODE:0014] (CB3Eh in the runs:
; KEY_DOWN is its field E46h); the field offsets stay numbers
comment    CODE:144BA Space (KEY_DOWN+39h) pushes the word at [ESI+0D48h] up by 258h a frame to 3E8h, then clears the key; down by C8h without it: presumably a nudge (upward), not checked
num        CODE:144BA
num        CODE:14520
comment    CODE:145A0 Left Alt (KEY_DOWN+38h) and Right Alt (+B8h) move the word at [ESI+0D46h] down / up by 258h to -3E8h / 3E8h: presumably nudges left and right, not checked; Space, Left Alt, Right Alt set bits 0, 1, 2 of [ESI+2A77h] on a new press
num        CODE:145A0
num        CODE:1460A
num        CODE:1461C
num        CODE:14686
comment    CODE:14757 the flippers (run: Left Shift held, the left flipper up in the picture): left = Left Shift or Left Ctrl (KEY_DOWN+2Ah, +1Dh) to [ESI+2A7Bh], right = Right Shift or Right Ctrl (+36h, E0 1Dh) to [ESI+2A7Ch]
num        CODE:14757
num        CODE:1475D
num        CODE:14769
num        CODE:1476F
comment    CODE:2F300 Enter (KEY_DOWN+1Ch) launches the waiting ball (run: F1, then Enter: the ball moves; Down, held 3 s, is read by no one): the index at [[ESI+2906h]] cleared, 1770h taken from the word +10h of the object at [ESI+1076h+index*4] (presumably its speed, upward)
num        CODE:2F306
num        CODE:2F315
comment    CODE:2A7FD in the attract mode: Esc (KEY_DOWN+1) to CODE:2A8AB; F1..F8 (+3Bh..+42h, the field at [ESI+0E81h]) or keypad Enter (E0 1Ch) set [ESI+8Eh] to 2 and add the key's number (1..8; keypad Enter 1) to [ESI+0D70h] (run: F1 starts a game, "PLAYERS 1"; the others not tried)
