; ILLUSION.386, the main program: a pMAX flat image, unpacked from the
; archive in ILLUSION.EXE by tools/illfiles.py (extract --all).
pmax       build/files/ILLUSION.386
segment    CODE 0 CODE             ; descriptor 0: the whole image, code and data
segment    TAIL 1 BSS              ; descriptor 1: base at the image's end, size 0; its use not known

name       CODE:02A3 ENTRY         ; the header's entry point
comment    CODE:02C7 INT 93h AH=11h: presumably the command tail (DS:EDX); its first word goes to CODE:086C
comment    CODE:02FF INT 94h AH=8 with CX:EDX = CODE:086C: the configuration file (run 2026-09-29: "ILLUSION.CFG" as the argument is opened, created when missing; none: "Error while initializing configuration file")
comment    CODE:35B34 INT 2Fh AX=1510h, MSCDEX device request, the header copied to real-mode memory first
comment    CODE:35B52 INT 2Fh AX=1500h, MSCDEX installed? drive letter to CODE:3631B (no MSCDEX: "CD error!")
comment    CODE:35C58 IOCTL input: audio disk info, then track info for each track to CODE:35F1B (run with -cue: 0Ah, then 0Bh for tracks 1..51)
code       CODE:35B0D CD_REQUEST   ; EBX = a request header in the image, copied to real-mode memory for INT 2Fh AX=1510h
code       CODE:35C09 CD_VOLUME    ; IOCTL output (command 0Ch), BL to CODE:35EF8 and 35EFA: the audio channel control (IOCTL 03h), channels 0 and 1 at volume BL, 2 and 3 at 0 (runs 2026-09-29 with -cd: 00 at each negative request, C0h at a track's start and a jingle's end)
name       CODE:35F1B CD_TRACK_START ; a dword a track, by its number (run: track 2's read at +8 when table 1 starts)
code       CODE:35DDC CD_PLAY      ; EBX = the track: the play request at CODE:35EA1 from its start to the next track's; ECX back = its length (run: "play frames 24470..38187 (track 2)" for EBX=2)
code       CODE:35E4F CD_STOP      ; the request at CODE:35E94 (command 85h, stop audio)
code       CODE:9D83 MUSIC_TRACK   ; stops the CD and plays track EBX; when bit 0 of CODE:CB97 is set, the length times [CCB8E] / 75 to CODE:9DBD, counted down at CODE:9CEA, which plays the track again at 0 (run, table 1: again after 159.3 s of a 182.9 s track: FRAME_RATE is 61 while the frame step, which counts, runs 70 times a second in the runner; 182.9 x 61/70 = 159.4)
comment    CODE:9BCA the table's first music record ([CODE:F470], header slot 35 of the table module): its word +8 the CD track, its byte +0Ah to CODE:CB97 (runs: tracks 2, 0Eh, 1Ah, 27h for tables 1..4, the byte 1 for all four)
code       CODE:2F85C MUSIC_REQUEST ; [CODE:0000] = an audio record of the table module (12 bytes, word +0 = 4): its word +8 to MUSIC_NEXT, its byte +0Ah to CODE:CB97 (state+59h); while LOST_BALL_RUNOUT is set only the byte, with bit 1 added (bit 1 is read by no instruction: the readers of state+59h are CODE:9D99 TEST 1, 9E9A TEST 4, the OR at 2F89A and the copy to +5Ah at 2F8E3, by the code and in runs 2026-09-29, -rwatch; so byte +0Ah 2 in a record has no effect found either); then its word +2 to state+2A84h (CODE:F5C2), +4 to +2A88h, +6 to +2A8Ah: the sound driver's request (CODE:9E83), +4 the order index, +6 the module slot; word +2 negative (FFFEh, FFFFh): first state+59h (the byte just stored) to +5Ah, which CODE:9DED puts back into +59h when a jingle ends, and MUSIC_NEXT to +2A82h (read by no one found)
name       CODE:F5BE MUSIC_NEXT    ; state+2A80h: a track asked for; CODE:9E13 plays it through MUSIC_TRACK when not 0 and sets it to 0 (runs, table 1: only 0 written in a game of three balls)
name       CODE:CB8E FRAME_RATE    ; state+50h: frames a second, what the waits of the event and display streams are multiplied by; set by the display mode (CODE:910E) and then by CODE:9265 (run 2026-09-29, table 2: 46h at t=118.31 by CODE:979A, 3Dh at 118.34 by CODE:92C7)
name       CODE:9265 MEASURE_RATE  ; one vertical retrace timed with PIT channel 0 (mode 0 from 0): 1234DCh / the ticks, at most 3Dh, to FRAME_RATE; so a 70 Hz mode counts 61 frames a second, and a game second lasts 61/70 s (runs: a track's replay after 159.3 s of 182.9, track 19's return after 16.6 s of 19.1)
comment    CODE:910E the display mode's routine by OPT_RESOLUTION, in the options screen's order: CODE:9743 VGA 360x350 (FRAME_RATE 46h; the runs' mode), 97A4 SVGA 640x480 and 9822 SVGA 800x600 (both INT 10h AX=4F02h, VESA, 3Ch), 96E7 VGA 320x240 (3Ch); CODE:9265 is called after it
name       CODE:009D OPTIONS       ; 200h bytes, read at CODE:0310 (INT 94h AH=7), cleared and written by the R option (CODE:32F16); the options screen's settings, one byte each in the screen's order (CODE:32C22 picks each line's text from SETSOUND.DAT by it, CODE:32C7C steps it by Enter, wrapping at the counts 2, 5, 3, 4, 2, 4 at CODE:32DE3): +0 balls per game (0 THREE, 1 FIVE), +1 OPT_ANGLE, +2 OPT_SCROLLING, +3 OPT_MULTIBALL, +4 OPT_TILT, +5 OPT_RESOLUTION; +6 a video mode number for the SVGA modes (CODE:0753, MODE_SVGA640), not a line of the screen, not followed (run 2026-09-29: all 0 with the GOG ILLUSION.CFG)
name       CODE:009E OPT_ANGLE     ; table angle: 0 NORMAL, 1 HIGH, 2 VERY HIGH, 3 VERY LOW, 4 LOW (to SLOPE_Y by OPTIONS_APPLY)
name       CODE:009F OPT_SCROLLING ; scrolling: 0 MEDIUM, 1 SMOOTH, 2 FAST (to SCROLL_DIVISOR by OPTIONS_APPLY)
name       CODE:00A0 OPT_MULTIBALL ; multiball maximum: 0 SIX, 1 THREE, 2 FOUR, 3 FIVE (read by CODE:B0E3 only: the ball counts of the two multiball commands of header slots 43, 44, see MULTIBALL_CAP)
name       CODE:00A1 OPT_TILT      ; tilt sensitivity: 0 NORMAL, 1 EARTHQUAKE (to TILT_STEP by OPTIONS_APPLY)
name       CODE:00A2 OPT_RESOLUTION ; 0 VGA 360x350, 1 SVGA 640x480, 2 SVGA 800x600, 3 VGA 320x240 (the options screen's list; run 2026-09-29: Enter on RESOLUTION wrote 1 by CODE:32C91 and the screen showed SVGA 640x480)
; the options in a game (2026-09-29; readers from a run on table 1, a game
; of three balls, doskit's -rwatch on CODE:D976, 0Eh bytes, and a search of
; build/ILLUSION.ASM for the field offsets; not in the table modules)
code       CODE:B2E0 OPTIONS_APPLY ; called once as a table is loaded (CODE:B272): the option bytes through the word tables at CODE:B2C0.. to the state words BALLS_PER_GAME .. RES_CODE
code       CODE:B0E3 MULTIBALL_CAP ; (from CODE:B0D8, the table's loading) the table's two numbers at CODE:B14E + 8 x (CODE:A311 - 1) (CODE:A311 the table's number 1..4, presumably; checked for table 1 only; table 1: 6, 4; 2: 0, 0; 3: 6, 0; 4: 4, 6), each lowered to 6, 3, 4, 5 by OPT_MULTIBALL and written, when not 0, to word +2 of the records the module header's +0ACh and +0B0h (slots 43, 44) point to. Those are event opcode 1Bh commands in mode streams (tools/event_streams.py: table 1 8FC8h in stream 8F62h and 8598h in 8530h, table 3 6EA2h in 6E7Eh, table 4 809Ah in 803Ah and 8786h in 8734h; table 2's slots and table 3's slot 44 point to zeros), and word +2 is the command's ball count: so the count in the module (3 or 6) is replaced by min(table's number, option), raised as well as lowered; the other opcode 1Bh commands (2 or 3 balls) are left as they are. Runs 2026-09-29 (Linux, table 1): the two words 6 and 4 after the call with the GOG ILLUSION.CFG (SIX), 3 and 3 with OPT_MULTIBALL poked to 1 (THREE); stream 8F62h forced (see docs/HANDOFF.md, "The multiball in a run"): 6 balls on the table with SIX, 3 with THREE
name       CODE:D976 BALLS_PER_GAME ; state+0E38h: 3 or 5 (OPTIONS+0); copied to state+0D36h at the game start (CODE:2A97C) and compared with it at zone type 0 (CODE:2C5EA)
name       CODE:D978 SLOPE_Y       ; state+0E3Ah: 3, 4, 5, 1, 2 by OPT_ANGLE (so VERY LOW 1 .. VERY HIGH 5); added each frame to the second word of the vector at [EDI] for a ball (CODE:134FF) and set in the balls' records at +3Eh (CODE:B7CC): the pull down the table (the run: read 23,690 times from the serve on). Runs 2026-09-29, table 1, OPT_ANGLE poked 0..4 at OPTIONS_APPLY: the ball's record (state+10AEh) had +3Eh = SLOPE_Y, and in its free fall at the serve its word +10h grew by 8 x SLOPE_Y a frame (24, 32, 40, 8, 16 for NORMAL, HIGH, VERY HIGH, VERY LOW, LOW; CODE:1352D's adds to +0Eh/+10h, the ball's speed, running 8 times a frame, presumably, not counted)
name       CODE:D97A SCROLL_DIVISOR ; state+0E3Ch: 3, 5, 1 by OPT_SCROLLING (MEDIUM, SMOOTH, FAST); CODE:30203 divides a distance by it (the run: 3165 reads, one a frame of play): a scroll step of a third, a fifth or all of the way, presumably
name       CODE:D97C TILT_STEP     ; state+0E3Eh: 100 (64h) NORMAL, 0 EARTHQUAKE; CODE:14C06 adds it to state+2A78h on a nudge key's new press (Space, Left Alt, Right Alt: the bits of state+2A77h), state+2A78h falls by 1 a call, and at C8h or more state+2A75h is set (the tilt: header slot 38, CODE:2B8ED); the add and the compare come before the fall. The count falls 4 a frame in runs: CODE:14BD7 runs with CODE:144AD, presumably, which is called four times a frame (CODE:10290...10424; the path from one to the other not traced) and NORMAL tilts at the third nudge within 25 frames of the first, EARTHQUAKE never. State+2A76h: its bits set on every call (CODE:144AD), a key's bit cleared while it is held, so only a new press adds. Runs 2026-09-29, table 1, NORMAL: Space three times 0.3 s apart fell 85 in 21 frames and did not tilt (peak 77h); 0.1 s apart it went 47h, A7h, F3h and tilted at the third (t=145.21)
name       CODE:D97E SLOPE_X       ; state+0E40h: always 0; the first word's counterpart of SLOPE_Y (CODE:134F2, B7C1)
name       CODE:D980 SERVE_SECONDS ; state+0E42h: always 0Ah; times FRAME_RATE to BALL_SAVE when the ball waits for its launch (GAME_PHASE 6, CODE:2B1E8): a ball save of 10 game seconds from each serve (run 2026-09-29: 262h = 610 frames at t=136.01)
name       CODE:D86C MULTIBALL_ON  ; state+0D2Eh: FFh from event opcode 1Bh (CODE:2D70E) until the balls on the table are down to one (run 2026-09-29, table 1: FFh at t=145.25, 00h when BALLS_ON_TABLE went from 2 to 1); also written by GAME_OVER (CODE:2AF26) with the first of the initials at CODE:2B09D (spaces, 20h, until a name is typed) for each player whose score passes no high score (run 2026-09-30, two players, the first typing "A": 41h), so MODE_RUN's first frame in the next game clears it and sets state+0D51h (read, not run)
name       CODE:D870 BALLS_ON_TABLE ; state+0D32h: balls in play (CODE:14DE2 walks that many); run 2026-09-29, table 1, a forced multiball of 6: rose 1..6 as they were served, fell one a lost ball once the ball save was out
name       CODE:D878 BALLS_TO_SERVE ; state+0D3Ah: balls waiting to be served, raised by event opcode 1Bh until they and BALLS_ON_TABLE make its count; while BALL_SAVE runs a lost ball is added here again (run 2026-09-29: the sum stayed 6, then 3 with THREE, until the save ran out)
name       CODE:D87C BALL_SAVE     ; state+0D3Eh: the ball save's frames, set by SERVE_SECONDS at a serve and by event opcode 0Bh (CODE:2D210), 0 at a new ball (CODE:2BD2B); counted down one a frame by play only (CODE:2B86B; held at 1 while state+0FC5h is set), so not while GAME_PHASE is 7; while not 0 a lost ball goes to CODE:2B95A (served again, GAME_PHASE 7 "DON'T MOVE") instead of CODE:2B9F6, and header slot 25's second lamp blinks: every 4 frames above 100, every frame above 50, dark at 50 and below (CODE:2B883, read, not looked at). Runs 2026-09-29, table 1, no flipper: from the launch (t=138.269) one less a frame; the ball lost at 140.23, 143.05, 146.05 and served again each time, 1.3 s in GAME_PHASE 7 and launched with no key; lost for good at 155.95. With SERVE_SECONDS poked to 30: 1830 frames ran out at 176.27 (38.0 s, the phase-7 pauses between), the ball lost for good at 177.46
name       CODE:D982 RES_CODE      ; state+0E44h: 1, 2, 3, 0 by OPT_RESOLUTION; read only by event opcode 19h (CODE:2D35E), which asks for 5
name       CODE:02A1 CODE_SEL      ; ENTRY's DS, descriptor 0's selector (1Ch in runs)
name       CODE:086C CFG_NAME      ; the configuration file's name, the command tail's first word (ENTRY; run 2026-09-29: "C:\ILLUSION.CFG"), opened by INT 94h AH=8
name       CODE:331BF LANGUAGE     ; SETSOUND.DAT's text block, set by SETUP_ARGS from INT 93h AH=15h: 0 English, 1 German, 2 Swedish (runs 2026-09-29: 0)
name       CODE:331C0 SETSOUND_TEXTS ; a far pointer (offset, selector at +4): LANGUAGE's table of text offsets in SETSOUND.DAT as pMAX loaded it (SETSOUND_LOAD, INT 94h AH=1; run 2026-09-29: offset 0Ch, selector 4, the file at linear 1473C0h)
name       CODE:331BC YES_KEYS     ; a word from the texts' entry +114h (English "Yy"), compared with AL at four places: the answer keys, presumably, not followed
name       CODE:30DB2 CFG_HEADER   ; the configuration file's first 20h bytes by INT 94h AH=5 (run 2026-09-29, the GOG file: "SB16.SDR", its NUL, then the file's bytes); a first dword FFFFFFFFh: no sound set-up yet
name       CODE:32F36 ARG_S        ; SETUP_ARGS: /S given (the sound set-up)
name       CODE:32F37 ARG_O        ; /O given (the options screen)
name       CODE:32F38 ARG_R        ; /R given (the options cleared)
code       CODE:328B4 SETSOUND_LOAD ; SETSOUND.DAT by INT 94h AH=1 (else "Error loading the Setsound language file" and exit); SETSOUND_TEXTS and YES_KEYS from it
code       CODE:32903 SETSOUND_FREE ; its block freed, INT 92h AH=5 with SETSOUND_TEXTS's selector
code       CODE:32F16 OPTIONS_RESET ; /R: OPTIONS cleared (80h dwords) and written back
code       CODE:32970 SOUND_SETUP  ; the sound set-up ("FLD Sound Driver Setup Utility")
code       CODE:32DA7 OPTIONS_SCREEN ; /O: "Pinball Illusions Options"
name       CODE:00A4 HISCORES      ; OPTIONS+7, C8h bytes: four tables of five 10-byte entries (initials, a NUL, then the score, presumably; not followed), the defaults copied in by HISCORE_INIT
name       CODE:08AC HISCORE_DEFAULTS ; C8h bytes as HISCORES has them ("ICE", "ANY", "AJL", "SN ", "KHN" in turns)
code       CODE:046E HISCORE_INIT  ; HISCORE_DEFAULTS to HISCORES when HISCORES's first byte is 0 or FFh (after the first VGA_INIT)
code       CODE:049A VGA_INIT      ; BIOS mode 13h, CR 13h 1Eh (240-byte lines), CR 9 40h, the line compare 108h, 15 retraces waited; LOADING_PIC unpacked into a 13EAh-byte block (INT 92h AH=4; run 2026-09-29: at linear 1473C0h, where SETSOUND.DAT was), its palette to the DAC and its pixels to A000:A916h (INT 93h AH=5's selector), the block freed
name       CODE:0974 LOADING_PIC   ; the "Loading" picture, run-length packed ("TCB", byte +5 the mark: mark, count, value); unpacked a RIX3 picture of 240x18 (+4 width, +6 height, +0Ah the palette, +30Ah the pixels; run 2026-09-29: on the screen at t=2.645)
code       CODE:757D CHOOSER_LOAD  ; after HISCORE_INIT: SOUND_START (through CODE:4CF2), then the chooser's files by INT 94h AH=1 (cube.rix, tube.rix, torus.rix, tinyfont.fnt ...)
name       CODE:6354 VIDEO_SEL     ; INT 93h AH=5's selector (run 2026-09-29: 48h; the video memory's, presumably, as VGA_INIT writes A000:A916h through it)
name       CODE:635E HOST_DS       ; DS kept by CHOOSER_LOAD
name       CODE:6358 DRIVER_SEL    ; the sound driver's block (INT 94h AH=1 by the name in DRIVER_CFG; run: 4)
name       CODE:6360 DRIVER_CFG    ; the configuration header again (INT 94h AH=5): the driver's name first; the driver's command 0 gets it as ES:EBX
name       CODE:8134 DRIVER_ENTRY  ; a far pointer: offset 0, the selector INT 93h AH=8 makes of DRIVER_SEL (run: 0Ch)
name       CODE:80BC INTRO_MOD_NAME ; "intro\MOD.INT", the module SOUND_START has the driver load into slot 0 (command 4, its result not looked at)
name       CODE:5DCF CHOOSER_LOADED ; a word: 1 once CHOOSER_LOAD has loaded the chooser's files (CODE:75B6); CMPed with 1 at CODE:2810, 36C8 (ATTRACT_START), 4E71, set 0 at CODE:5040: so that the first chooser does not load them again; after a table the chooser loads menuchar.rix (CODE:2840) and its other files (CODE:4E98) itself (in the port since 2026-10-01)
name       CODE:1311 CUBE_SEL      ; chooser\cube.rix's selector (INT 94h AH=1 in CHOOSER_LOAD; run 2026-09-29: 44h, MOD.INT's freed one); CUBE_SEL, TUBE_SEL, TORUS_SEL are read as a table by EBX*2 (CODE:3778, 469B, 4A05; not followed)
name       CODE:1313 TUBE_SEL      ; chooser\tube.rix's (run: 134h)
name       CODE:1315 TORUS_SEL     ; chooser\torus.rix's (run: 13Ch)
name       CODE:1317 MENUCHAR_SEL  ; chooser\menuchar.rix's (run: 154h)
name       CODE:6352 INTROANI_SEL  ; intro\introani.roy's (run: 15Ch)
name       CODE:8118 INTROANI_SIZE ; its size, INT 94h AH=1's EDX (run: 157FCh, the file's 88060 bytes); written only
name       CODE:811C INTROANI_POS  ; 0 in CHOOSER_LOAD; ESI read from it and written back with DS INTROANI_SEL at CODE:6BD8, presumably the position in the file (not followed)
name       CODE:6356 INTROPIX_SEL  ; intro\intropix.mgl's (run: 164h)
name       CODE:6348 SCROLL_SEL    ; intro\SCROLL.DLT's (run: 16Ch)
name       CODE:634A BKGR_SEL      ; intro\BKGR.FLD's (run: 174h)
name       CODE:634C PCSKY_SEL     ; intro\PCSKY.FLD's (run: 17Ch)
code       CODE:7341 INTRO_PALS_MAKE ; reached from CODE:7885 through CODE:7438's checksummed jump; INTRO_PALS made from PCSKY.FLD's first 30h bytes (16 colours): rows 0-2 with 0 added, row 3 cleared, rows 4-15 with 0, 0, 0, 0, 0, 3, 0Ah, 0, 19h, 23h, 2Dh, 0Fh added; EDI by CODE:7441 ([CODE:905B] less the byte sum of CODE:6F43..7028: 8D3Ch in the run's memory)
code       CODE:732D PAL_ADD       ; 30h bytes from DS:0 to ES:EDI, BL added to each, at most 3Fh
name       CODE:8D3C INTRO_PALS    ; 300h bytes: 16 rows of 16 DAC colours (INTRO_PALS_MAKE); run 2026-09-29: made at CODE:78D9
code       CODE:7029 INTRO_TICK    ; the driver's command 0Dh (the module's ticks played, 50 a second: NOSOUND's CMD_POSITION); INTRO_TIME raised to it; each INTRO_SCRIPT entry from INTRO_NEXT whose dword is at most INTRO_TIME has its routine called, INTRO_NEXT moved on 8, up to INTRO_MOD_NAME (the table's end)
name       CODE:7ABC INTRO_SCRIPT  ; the intro's script: entries of a dword (a position INTRO_TICK compares with INTRO_TIME) and a routine
name       CODE:8124 INTRO_TIME    ; the highest position INTRO_TICK has seen; 0 in CHOOSER_LOAD
name       CODE:8128 INTRO_NEXT    ; the next INTRO_SCRIPT entry; INTRO_SCRIPT in CHOOSER_LOAD
name       CODE:903C INTRO_END     ; a byte: 1 by CODE:6E1E, the routine of INTRO_SCRIPT's last entry (at CODE:80B4, position B4Eh), which CHOOSER_LOAD's loop at CODE:7996 waits for; 0 in CHOOSER_LOAD
code       CODE:698A INTRO_MODE    ; reached from CODE:78C9 through CODE:4CF2's checksummed jump ([CODE:908B] less the byte sum of CODE:6A20..8115: 698Ah in the run's memory); mode 13h unchained (sequencer 4 = 06h), misc output E3h, its own CRTC values (CR 6, 7, 9, 10h-12h, 14h-17h), all four planes cleared
code       CODE:6FC0 INTROPIX_PALS ; reached from CODE:78DE the same way ([CODE:9097]: 6FC0h); INTRO_PAL1 and INTRO_PAL2 from intropix.mgl's 32 two-byte colours at its dword +18h; EDI by CODE:7441 ([CODE:9067] less the byte sum of CODE:698A..7ABB: 813Ch)
code       CODE:6EBE PAL12_ROW     ; 32 colours of two bytes (red; green, blue in the nibbles; each 0-0Fh made 0-30h) from DS:EBP to ES:EDI as DAC colours, EDI then past the row's other 32
code       CODE:6EE9 PAL12_ROW_HALF ; as PAL12_ROW, each component halved and CH, DL, DH added
code       CODE:6EAC PAL_FILL      ; 64 DAC colours of CH, DL, DH at ES:EDI
name       CODE:813C INTRO_PAL1    ; 300h bytes (INTROPIX_PALS): row 0 intropix.mgl's colours, 1 and 2 flat (26h,20h,20h and 3Fh,3Fh,3Fh), 3 the colours halved plus (18h,12h,12h); the other 32 of rows 0 and 3 not written by it
name       CODE:843C INTRO_PAL2    ; 300h bytes (INTROPIX_PALS): intropix.mgl's 32 colours at the start of each of the four rows
name       CODE:873C INTRO_BLACK   ; 300h bytes, zero in the run's memory at CODE:7925 (presumably black; not written by any routine seen yet); FADE_FROM and FADE_TO at CODE:78F3
code       CODE:6E35 INTRO_FRAME   ; the driver's command 6 (CODE:7223) and FADE_FRAME, with DS the host's
code       CODE:6F43 FADE_FRAME    ; with FADE_LEVEL above 0: FADE_STEP taken off it, the DAC set to FADE_FROM * level + FADE_TO * (40h - level), over 40h, after a retrace; else only the retrace waited (CODE:6E26)
code       CODE:6E26 RETRACE_WAIT  ; 3DAh bit 3 set, then clear
code       CODE:6F1F FADE_TO_SET   ; 300h bytes from ESI to CODE:6380, FADE_TO set to it
name       CODE:6980 FADE_FROM     ; a 300h-byte palette's offset (FADE_FRAME)
name       CODE:6984 FADE_TO       ; a 300h-byte palette's offset (FADE_FRAME)
name       CODE:6988 FADE_LEVEL    ; a byte, 40h at a fade's start, down by FADE_STEP each FADE_FRAME
name       CODE:6989 FADE_STEP     ; a byte
name       CODE:6680 FADE_OUT      ; 300h bytes: FADE_FRAME's palette for the DAC, colour 3Fh made black in it
code       CODE:6E49 INTROPIX_SHOW ; reached from CODE:795A through CODE:7438's checksummed jump ([CODE:9043] less the byte sum of CODE:7341..73D7: 6E49h); intropix.mgl's picture after its 32 colours (from its dword +18h + 40h) to the four planes at 7D0h, 2580h bytes each
code       CODE:7223 DRIVER_MIX    ; the driver's command 6
name       CODE:6380 FADE_PAL      ; 300h bytes FADE_TO_SET copies a palette to
code       CODE:6A20 VIEW_TOP      ; the start address 0 (before and after an INTRO_FRAME), CR 7 3Eh, CR 9 41h, CR 12h 21h
code       CODE:6A5C VIEW_2D50     ; the start address 2D50h, INTRO_FRAME, CR 9 40h
code       CODE:6A7C VIEW_3CF0     ; the start address 3CF0h, INTRO_FRAME, CR 9 40h, CR 12h 8Fh (400 lines) and others
code       CODE:6B8A ANI_PASS      ; one pass of an introani.roy frame from DS:ESI at 7D0h: a byte below 10h XCHGed with video memory, 10h a word to skip, 11h-FEh that less 10h to skip, FFh the end
code       CODE:6BB1 ANI_FRAME     ; INTRO_SCRIPT's most (174 of 192): introani.roy's next frame at INTROANI_POS in write mode 2 with function XOR, ANI_PASS for pixel bit 6, then for bit 7
code       CODE:6C82 PIC_SHOW_240  ; intropix.mgl's picture at its dword [ESI] (300h bytes of palette, then 4B00h bytes a plane) to 3CF0h, an INTRO_FRAME and DRIVER_MIX after each plane; a fade from CODE:8A3C to its palette; VIEW_2D50
code       CODE:6D50 PIC_SHOW_400  ; the same with 7D00h bytes a plane and VIEW_3CF0
code       CODE:6AC6 INTRO_FADE_IN ; INTRO_SCRIPT: the start address 0, a fade from INTRO_BLACK to INTRO_PAL1, step 4
code       CODE:6AF9 INTRO_FADE_21 ; INTRO_SCRIPT: a fade from INTRO_PAL2 to INTRO_PAL1, step 2 (CODE:6B1C the same code)
code       CODE:6B3F INTRO_FADE_12 ; INTRO_SCRIPT: a fade from INTRO_PAL1 to INTRO_PAL2, step 2
code       CODE:6B62 INTRO_FADE_TOP ; INTRO_SCRIPT: a fade from CODE:8A3C to INTRO_PAL1, step 4; VIEW_TOP
code       CODE:6C4B INTRO_PIC_LAST ; INTRO_SCRIPT: a fade from CODE:8A3C to itself, INTRO_FRAME, DRIVER_MIX, PIC_SHOW_400 of intropix.mgl's dword +1Ch
code       CODE:72BB INTRO_BKGR    ; reached from CODE:7A0F through CODE:4CF2's checksummed jump ([CODE:907F] less the byte sum of CODE:6A20..8115: 72BBh in the run's memory; run 2026-09-30: reached at t=72.13); BKGR.FLD and PCSKY.FLD (from +300h) to 3CF0h, plane by plane, 12C0h dwords each: a PCSKY dword ORed with the BKGR dword shifted left 4
code       CODE:7230 SCROLL_FRAME  ; SCROLL.DLT's next frame from SCROLL_POS at 3CF0h, in write mode 2 with function XOR and bit mask 80h (pixel bit 7): pairs of an offset and the plane bits, FFh a line's end, 240 lines; SCROLL_LEFT counted down
name       CODE:634E SCROLL_POS    ; SCROLL_FRAME's position in SCROLL.DLT; 0 at CODE:7A22
name       CODE:8130 SCROLL_LEFT   ; SCROLL_FRAME's count: 780h at CODE:79EA, the scroller ends at 21h (CODE:7A44)
code       CODE:73D8 INTRO_FREE    ; reached from CODE:7AB6 through CODE:7438's checksummed jump ([CODE:235E] less the byte sum of CODE:4CE8..55E2: 73D8h; run 2026-09-30: reached at t=104.36); INT 92h AH=5 (freed) for INTROANI_SEL, INTROPIX_SEL, SCROLL_SEL, BKGR_SEL, PCSKY_SEL; its RET to CODE:7ABB, CHOOSER_LOAD's RET
