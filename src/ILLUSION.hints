; CODE:BA9B, table 1)
code       CODE:911F TBL_VGA_INIT  ; a retrace waited, DAC_LOAD TBL_PALETTE, unchained (CR 11h 0, sequencer 4 AND F6h, CR 14h bit 6 off, CR 17h E3h), video memory 0 (map mask 0Fh), the mode routine of MODE_ROUTINES by OPT_RESOLUTION, MEASURE_RATE, video memory 0 again, DAC_LOAD TBL_PALETTE again (MODULE_HEADER+50h, the stage's palette pointer, read and not used), STAGE_TO_VRAM, policy 0, SPOOKY_SEL (32DC0h bytes, INT 92h AH=0Ah), STAGE_TO_SPOOKY. Run 2026-09-30: three retrace edges counted in it (frames 5866 to 5869)
name       CODE:910E MODE_ROUTINES
name       CODE:AA2B TBL_PALETTE   ; 300h bytes, shifted right 2 to the DAC
name       CODE:A72B TBL_FADE_PAL  ; 300h bytes, TABLE_FADE_IN's mix
code       CODE:A654 TABLE_FADE_IN ; DM_SHOW, TOP_COLOURS into the stage's palette (MODULE_HEADER+50h) from colour FCh, then 32 times (CL 20h down to 1): FADE_MIX of the stage's palette and TBL_PALETTE, a retrace waited, FADE_PAL_SET
code       CODE:A704 FADE_MIX      ; TBL_FADE_PAL = (ESI x (20h - CL) + EDI x CL) / 20h, byte by byte
code       CODE:B02B FADE_PAL_SET  ; TBL_FADE_PAL to the DAC from colour 0, shifted right 2
code       CODE:92FA DAC_LOAD      ; 300h bytes at ES:ESI, each shifted right 2, to the DAC from colour 0
code       CODE:3D389 MAP_MASK     ; the sequencer's map mask from AH
code       CODE:3D39F VGA_UNCHAINED ; mode 13h (INT 10h), then unchained as TBL_VGA_INIT does it
code       CODE:3D3D4 CRTC_WORDS_SET ; CR 11h bit 7 off, the ten CRTC words at CRTC_WORDS, Misc (3CCh) OR C0h
name       CODE:3D40B CRTC_WORDS
code       CODE:9444 VGA360_REGS   ; sequencer 4 = 6, map mask 0Fh, Misc A7h (the 28 MHz clock), the CRTC's timings for 360x350 (CR 0..17h), CR 1 53h, CR 11h A5h
code       CODE:3D320 TBL_SPLIT_SET ; the line compare from CX less 1, CH bit 0 to CR 7 bit 4, bit 1 to CR 9 bit 6 (as SPLIT_SET, which clears the latter)
name       CODE:911E MODE_SVGA800_FLAG ; 1 by MODE_SVGA800, 0 by the others
name       CODE:D890 TBL_D890      ; a word each mode sets (7Fh VGA 360, 53h VGA 320, B3h SVGA 640), not followed
name       CODE:D892 SCROLL_MAX    ; state+0D54h: the last line the attract scroll goes to (11Ah, 188h, 98h by the mode: the stage's 600 lines less the lines shown, presumably)
name       CODE:9B8E VSYNC_START_ARG ; the dword command 0Fh gets in ECX (CODE:B9B9)
name       CODE:B922 TBL_B922      ; a dword each mode sets (2, VGA 320 0), not followed
code       CODE:9392 STAGE_BITS    ; AL: the bit 7 - DL of the eight bytes at GS:ESI, 30h apart, the first one's to bit 0
code       CODE:933F STAGE_TO_VRAM ; for each plane DL 0..3 (map mask STAGE_MASK, rotated a bit after each): from EBP (MODULE_HEADER+4Ch, the stage, STAGE.M) 258h lines of 2Ah words (STAGE_BITS for DL and for DL XOR 4) to video memory from 1500h, the source 180h bytes a line
name       CODE:933E STAGE_MASK    ; 11h, rotated four times a call, so 11h again
code       CODE:93FB STAGE_TO_SPOOKY ; the same into SPOOKY_SEL's block from 0, the four planes one after the other (4 x C4E0h bytes)
name       CODE:A119 SPOOKY_SEL    ; "Spooky", 32DC0h bytes
; TABLE_LOAD2's end (2026-09-30, the code; the port against a run at
; CODE:28C45, table 1)
; the game's start (2026-09-30, the code; the port against a run at
; CODE:30114, the four tables)
code       CODE:9F2C SFX_PLAY      ; the sound record at [CODE:0000] on the driver's channel 4 (command 9: FS:ESI the sample +16h, ECX its length +8, BL the note +6, BH the volume +4) unless SFX_CHECK refuses
code       CODE:9F5C SFX_CHECK     ; command 12h (channel 4 still playing a sound); CF when it is and the record's priority +2 is below SFX_PRIO; SFX_PRIO set to it either way
name       CODE:9F86 SFX_PRIO
code       CODE:B928 TABLE_GAME    ; DISPLAY_RESET, LIGHTS_RESET, DM_CLEAR, SCREEN_START, CODE:30114, CODE:156C4, CODE:1048B, LIGHTS_STEP, CODE:2ED15, CODE:A654, CODE:D973 1, GAME_PHASE 1, QUIT_TABLE 0, CODE:9B92, then the loop from CODE:B976 until QUIT_TABLE
code       CODE:2A30E DISPLAY_RESET ; the display queue's state (state+2A26h .. 2A5Fh) 0, state+2A2Ah = DISPLAY_QBUF (its first dword 0), DM_CLEAR
name       CODE:F71C DISPLAY_QBUF
code       CODE:9311 SCREEN_START  ; the CRTC's start address SCREEN_LINE x 54h + 1500h
name       CODE:A2B9 SCREEN_LINE   ; the screen's first line of the stage (see CODE:BB0A)
code       CODE:29AF9 LIGHTS_RESET ; along header slot 14's groups (state+28DEh, pointers ended by 0; a group's byte +4 AND 6, its +0 the first light, a light's +10h the next): each light without +2 bit 2 LIGHT_INIT; its byte in state+16B2h (by its running number in CODE:0038) 0; +3, +4, +0, +5 0, +1 FFh, +2 bits 0, 1 cleared; state+16AEh the first group, state+16ACh FFFFh; state+17B8h and state+1822h lists emptied
code       CODE:28FF8 LIGHT_INIT   ; the light [CODE:0000]: without +2 bit 3 its LIGHTS_ONE1 byte (+1Ch) 0; with it the drop target's picture 2 x +1Ch at +14h, +18h (DROP_PIC)
code       CODE:28FBA LIGHT_ON      ; the light [CODE:0000]: without +2 bit 3 its LIGHTS_ONE1 byte (+1Ch) FFh; with it the drop target's picture 2 x +1Ch - 1 at +14h, +18h (DROP_PIC)
code       CODE:2EF17 GROUP_FLASH   ; the group [CODE:0008] onto the stack at state+1822h (a word 10h, the group; for GROUP_FLASH_STEP), bit 0 of each of its lights' +2 set
code       CODE:2ED15 FLASH_STEP    ; LIGHT_FLASH_STEP, GROUP_FLASH_STEP
code       CODE:2ED20 LIGHT_FLASH_STEP ; the flashing light state+17B2h, its count state+17B6h down by one a call: +1 0 while the count's bit 1 is set, else FFh; at 0 no longer flashing (+2 bit 0 cleared); with none the next from the stack of 6-byte entries (word count, light) below state+17B8h (empty at state+17BCh)
code       CODE:2EDD8 GROUP_FLASH_STEP ; the same for the group state+181Ch (count state+1820h, stack below state+1822h, empty at state+1826h), all its lights' +1; at 0 the group's +4 bit 0 cleared and its lights' +0 and +5 lose the bits of state+0D74h (the current player's, presumably), +2 bit 0 cleared
code       CODE:2912B DROP_PIC     ; DROPS_SEL's picture ESI (the dword table at the block's start; a picture: width, height, bytes) by SPRITE4_DRAW
code       CODE:29265 SPRITE4_DRAW ; the picture at FS:[SPR_SRC] (SPR_W x SPR_H, a quarter of the width a row per plane, FFh transparent) at SPR_X, SPR_Y: into SPOOKY_SEL (the planes by SPR_PLANES, from x AND 3's, the next byte after the fourth), then into video memory from 1500h where HIDELIGHTS_SEL's byte of the same plane is 0
name       CODE:28C31 SPR_X
name       CODE:28C35 SPR_Y
name       CODE:28C39 SPR_W
name       CODE:28C3D SPR_H
name       CODE:28C41 SPR_SRC
name       CODE:28C00 SPR_SKIP     ; 54h less a row's bytes
name       CODE:28BFC SPR_AT       ; y x 54h + x / 4
name       CODE:28C01 SPR_PLANES   ; the planes' offsets in SPOOKY_SEL: 0, 24EA0h, 189C0h, C4E0h, 0 (by 5 - SPR_PLANE)
name       CODE:29426 SPR_PLANE
name       CODE:29427 SPR_PLANE0
name       CODE:29428 SPR_CARRY
code       CODE:30114 ATTRACT_SCROLL ; the attract mode's scroll a line on: ATTRACT_LINE (state+9Ah) down to SCROLL_MAX, then back up to 0 (ATTRACT_DIR, state+98h, 0 down, FFh up), to it and SCROLL_LINE (state+0D58h); CRT_NEXT_SET for it plus SCROLL_ADD (state+0D4Ch); [CODE:0024]'s low word SCROLL_X (state+0D4Ah). Work cells CODE:0020, 0024
name       CODE:CBD8 ATTRACT_LINE
name       CODE:CBD6 ATTRACT_DIR
name       CODE:D896 SCROLL_LINE
name       CODE:D88A SCROLL_ADD    ; added to the line for the CRT start (not followed)
name       CODE:D888 SCROLL_X      ; (the name a guess: the word before SCROLL_ADD; not followed)
code       CODE:29813 CRT_NEXT_SET ; CRT_NEXT = [CODE:0020]'s word x 54h + 1500h
name       CODE:BAD2 CRT_NEXT      ; the CRT start address the driver's command-0Fh routine (CODE:B9B9) sets at the retrace
code       CODE:156C4 FLIPPERS_DRAW ; each flipper (type 3 passed over) whose angle's number +1Ah differs from the one drawn (+1F4h): the old one put back (FLIP_ERASE), the new drawn (FLIP_BLIT), +1F4h updated; or drawn again when byte +1F6h asks (cleared)
code       CODE:1572D FLIP_BLIT    ; the kept pixels of the angle (+30h by |+1Ah|, FLIP_ANGLE2's box) drawn column by column (CODE:1578B, 157EA: a column's first byte is the rows passed over, then up to 55 rows until a 0; 16-bit SI and DI addressing), map mask 1, 2, 4, 8
code       CODE:15C1A FLIP_ERASE   ; the same rows put back from SPOOKY_SEL (CODE:15C78, 15CED)
code       CODE:1637B FLIP_ANGLE2  ; CX: +6 plus +1Ah around 0..77h (without +0Ah's sign)
code       CODE:1048B FLIPPERS_STEP ; FLIPPERS_MOVE four times, then FLIPPER_SOUNDS (CODE:10471, 10476, 1047B, 10480 enter the same chain for four to one moves)
code       CODE:144AD FLIPPERS_MOVE ; the nudges (Space: state+0D48h up by 258h to 3E8h, else down by C8h to 0, NUDGE_Y state+0D4Ch its high byte; Left/Right Alt: state+0D46h by 258h to -3E8h / 3E8h, else back toward 0 by C8h, NUDGE_X state+0D4Ah its high byte), the flipper keys to state+2A7Bh (left) and 2A7Ch (right), then each flipper record of header slot 22 (1F7h bytes, ended by type 0, type 3 passed over; +0Ah not 0 the left one, with the left key): with state+2A7Fh set and its key down it moves up (the speed +10h times 32h over FRAME_RATE added to the position +12h; at the limit +14h the position held, speed 0, state+2A7Dh/2A7Eh FFh; else the speed less/plus +16h, bounded by +18h), else down (the speed +10h added unscaled, bounded by the rest at 0 (left -1), where state+2A7Dh/2A7Eh go 0, and by +14h; the speed plus/less +0Ch, bounded by +0Eh); +1Ah the position over 40h. Then the tilt count (see TILT_STEP) unless state+0FC5h is set. Work cells CODE:0000, 0020 .. 0030
code       CODE:104A5 FLIPPER_SOUNDS ; for the left and right flipper, when state+2A7Dh / 2A7Eh differ from FLIP_L_WAS / FLIP_R_WAS: SFX_PLAY of FLIP_UP_SFX (now FFh, the flipper at its top, presumably) or FLIP_DOWN_SFX (now 0, back at rest); the byte kept
name       CODE:1053E FLIP_L_WAS
name       CODE:1053F FLIP_R_WAS
name       CODE:1004C FLIP_UP_SFX  ; a sound record (type 2, presumably; its sample not looked at)
name       CODE:10066 FLIP_DOWN_SFX ; likewise
name       CODE:B14E MULTIBALL_COUNTS ; two dwords a table (see MULTIBALL_CAP)
name       CODE:B13E MULTIBALL_MAX ; four dwords by OPT_MULTIBALL: 6, 3, 4, 5
code       CODE:BA9B TOP_COLOURS_SET ; TOP_COLOURS's twelve bytes, shifted right 2, to the DAC from colour FCh
name       CODE:BA83 TOP_COLOURS
code       CODE:BAB6 TOP_COLOURS2_SET ; the same from TOP_COLOURS2 (display opcode 18h)
name       CODE:BA8F TOP_COLOURS2
code       CODE:B797 BALLS_INIT    ; the 13 ball records at state+10AEh (76h bytes): BALL_BUNDLE1, SLOPE_X and SLOPE_Y to +3Ch, +3Eh; then each listed at state+1046h and state+107Ah, numbered 1..13 in +0Ah, BALL_PLACE; state+0E34h, 0E35h 0, the dword state+0D76h 0D7Ah; the flipper records of header slot 22 (1F7h bytes, type 0 ends, 3 passed over): the steps from +6 to +8 (by 1, -1 when +0Ah is 1, around 0..77h) into +14h as steps x 40h - 1 and +12h 0, or for -1 +12h = +14h = steps x -40h and +1Ah FFFFh. Uses CODE:0000, 0004, 0010, 0020, 0038, 003C as work cells
code       CODE:2C414 BALL_BUNDLE1 ; state+28A6h's six pointers (MODULE_HEADER slots 0-5) into the ball at [CODE:0010]'s +50h..+64h, its byte +8 0
code       CODE:2C467 BALL_BUNDLE2 ; the same from state+28BEh (slots 6-11), byte +8 FFh
code       CODE:28C45 LIGHTS_LOAD  ; LIGHTS_ONE1 and LIGHTS_ONE2 (FFh bytes each) all 1, HIDELIGHTS_SEL's first 31380h bytes 0, LIGHTS_NAME ("Lights") into LIGHTS_SEL, LIGHTS_SIZE (CF), LIGHTS_POS 0, DROPS_LOAD's CF
name       CODE:283BE LIGHTS_ONE1  ; FFh bytes set to 1 (who reads them not followed)
name       CODE:284BD LIGHTS_ONE2  ; the same
name       CODE:28C19 LIGHTS_SEL
name       CODE:28C1B LIGHTS_SIZE
name       CODE:28C15 LIGHTS_POS   ; a dword cleared after the load (not followed)
name       CODE:28CE1 LIGHTS_NAME  ; "data\s00n\masks\lights.mgl" (the name after it, table 3's light2.mgl, not used here)
code       CODE:28D64 DROPS_LOAD   ; DROPS_NAME ("Droptargets (Gfx)") into DROPS_SEL, DROPS_SIZE (CF); but on table 2 MASKS_NAME ("Droptargets (masks)") into MASKS_SEL, MASKS_SIZE, whose failure gives CF clear
name       CODE:28C25 DROPS_SEL
name       CODE:28C27 DROPS_SIZE
name       CODE:28C2B MASKS_SEL
name       CODE:28C2D MASKS_SIZE
name       CODE:28E29 DROPS_NAME   ; "data\s00n\masks\drops.mgl"
name       CODE:28E43 MASKS_NAME   ; "data\s00n\masks\masks.mgl"
code       CODE:15030 FLIPDAT_LOAD ; FLIPDAT_NAME ("flipdat") by INT 94h AH=1 into FLIPDAT_SEL, added to BLOCKS (CF when it fails), FLIPPERS_PREP, CODE:156C3 (a RET)
name       CODE:1502E FLIPDAT_SEL
name       CODE:1503A FLIPDAT_NAME ; "data\misc\flipdat1.m"
code       CODE:150A5 FLIPPERS_PREP ; FLIPPER_BLOCKS, FLIPPER_RENDER
code       CODE:150B0 FLIPPER_BLOCKS ; for the four flipper records of header slot 22 (type 3 passed over): per angle from +6 to +8 (step 1, or -1 when +0Ah is not 0, around 0..77h) four words into +F2h up (or +1EAh down): x +2 less FLIP_SHAPES's x and 10h, y +4 less its y and 10h, +F0h, y less its y plus its height; then (the heights' sum + 32h) x 40h bytes twice by INT 92h AH=0Ah, cleared and added to BLOCKS: "flipper gfx data" (selector to +1F2h), "flipper mask data" (DS offset to +28h, size to +2Ch)
name       CODE:14E4E FLIP_SHAPES  ; 78h entries of 4 bytes by angle: x, y, height, and a fourth (not followed)
name       CODE:15279 FLIP_BLOCK_SEL ; the last block's selector
code       CODE:1527F FLIPPER_RENDER ; for the four flipper records (type 3 passed over), +1Ah kept and used as the angle's number, per angle from +6 to +8: +30h + 2 x number the angle's offset in the "flipper gfx data" block (FS), FLIP_BG_SAVE, FLIP_DRAW, FLIP_DIFF, FLIP_BG_RESTORE, FLIP_MASK
name       CODE:1527B FLIP_NEXT_DI ; the next angle's offset in the gfx block
code       CODE:1634F FLIP_ANGLE   ; CX: the record's +6 plus +1Ah (less when +0Ah is not 0), around 0..77h
code       CODE:16482 FLIP_ROWS    ; EBX from FLIP_SHAPES to the entry of angle ECX, AX the rows of flipdat before it (each angle's height + 2)
code       CODE:153B7 FLIP_BG_SAVE ; the flipper's box at its angle (x less the shape's x over 4, y less its y times 54h, height + 2 rows) read from video memory from 1500h, 16 bytes a row, plane by plane (read map 0..3), to FS:EDI (CODE:15404)
code       CODE:15404 FLIP_BG_COPY
code       CODE:3D394 READ_MAP     ; the graphics controller's read map from AH
code       CODE:16399 FLIP_DRAW    ; the flipper at its angle from flipdat (FLIPDAT_SEL, the rows FLIP_ROWS gives, 20h bytes a row: four planes of 8 bytes, 64 pixels) into video memory over the box, height + 1 rows, colour 0 left out; map mask FLIP_DRAW_MASK (11h rotated by x AND 3, then a bit a pixel)
name       CODE:16398 FLIP_DRAW_MASK
code       CODE:16440 FLIP_PIXEL   ; AL the colour 0..15 of pixel bit 7 - DL of byte BP of the row at GS:ESI (four planes 8 bytes apart)
code       CODE:1549E FLIP_DIFF    ; the box read back plane by plane against what FLIP_BG_SAVE kept at FS:EDI: equal pixels 0, changed ones kept; in the plane's first row a column still 0 gets the row number where it first changed (FLIP_DIFF_COL, FLIP_DIFF_ROW) (CODE:154EB)
code       CODE:154EB FLIP_DIFF_COPY
name       CODE:156BE FLIP_DIFF_COL
name       CODE:156C2 FLIP_DIFF_ROW
code       CODE:1536E FLIP_BG_RESTORE ; the box put back from SPOOKY_SEL's copy of the stage (CODE:167E4, planes C4E0h apart, map mask 1, 2, 4, 8)
code       CODE:167E4 SPOOKY_COPY
code       CODE:16494 FLIP_MASK    ; the collision mask at the angle into the "flipper mask data" block (+28h) from the word +B0h + 2 x +1Ah (16-byte units): 16 bytes a row of the collision map at +1Ch (2Ah bytes a line, rotated by FLIP_MASK_SHIFT), 20h rows above, height + 1 rows with the flipper's pixels ORed into the middle 8 bytes, 20h below; the next angle's start to +B2h + 2 x +1Ah
name       CODE:167E3 FLIP_MASK_SHIFT ; (x - 20h) AND 7
code       CODE:29A5A BALL_PLACE   ; the ball at [CODE:0010] to 11Ch, 1FEh (+12h, +14h, keeping their low three bits) and shifted by 0Ah into +1Eh, +22h (the second from EDI whose high word the first left: MOV DI), the high bytes of +0Eh, +10h 2, byte +1 0, BALL_BUNDLE2
; the game's sound start (2026-09-30, the code; the port against a run at
; CODE:B976, the four tables)
code       CODE:9B92 GAME_SOUND    ; the driver's command 0Eh with DRV_TICK, 0Fh with DRV_FRAME and VSYNC_START_ARG, MOD_SILENT, the first music record (MODULE_HEADER+8Ch) to MUSIC_FLAGS (byte +0Ah) and MUSIC_TRACK (word +8), MUSIC_RET_ORDER 0 first, SFX_PRIO 0, SOUND_PAUSED 0, command 1 with CX 3
code       CODE:9C1A MOD_SILENT    ; MOD_LEVEL 0, the driver's command 0Ch (MASTER_VOL) with BX 0
code       CODE:9C34 MOD_FULL      ; MOD_LEVEL 100h, command 0Ch with BX 100h
name       CODE:9CA0 MOD_LEVEL     ; the last level given to command 0Ch; kept at CODE:9CA2 by CODE:9C6C
code       CODE:9C6C SOUND_PAUSE  ; SOUND_PAUSED FFh, MOD_LEVEL kept in MOD_LEVEL_KEPT and MOD_SILENT, CD_LEVEL kept in CD_LEVEL_KEPT and CD_VOLUME 0 between two SND_PAUSE (the pause)
name       CODE:9CA2 MOD_LEVEL_KEPT
name       CODE:9CA5 CD_LEVEL_KEPT
code       CODE:9CA6 SOUND_RESUME ; SOUND_PAUSED 0, CD_VOLUME CD_LEVEL_KEPT between two SND_PAUSE, MOD_FULL if MOD_LEVEL_KEPT is not 0 (CD_LEVEL and MOD_LEVEL themselves left as they are)
name       CODE:9C6B SOUND_PAUSED  ; FFh from CODE:9C6C (module level 0, CD volume 0, the levels kept; called at CODE:2B53E, presumably the pause, not run) to CODE:9CA6 (put back); while FFh MUSIC_COUNTDOWN holds at 1
name       CODE:CB97 MUSIC_FLAGS   ; state+59h: a music record's byte +0Ah (bit 0 the track's time counted, bit 2 the CD silent for a jingle)
name       CODE:9DBD TRACK_LEFT    ; MUSIC_TRACK's frames until the track is played again (or the module music returns), counted down by MUSIC_COUNTDOWN
name       CODE:9DC1 TRACK_NO      ; the track MUSIC_TRACK played last
name       CODE:9CE6 MUSIC_RET_ORDER ; the order index to go back to when the track's time is up (0: the track again)
name       CODE:9CE8 MUSIC_RET_SLOT
code       CODE:35E65 RB_FRAMES    ; EAX, a Red Book address (frame, second, minute), in frames: minute x 1194h + second x 4Bh + frame (the second's word keeps the dword's top byte; 0 in a Red Book address)
name       CODE:35E94 CD_STOP_REQ  ; MSCDEX request, command 85h
name       CODE:35EA1 CD_PLAY_REQ  ; MSCDEX request, command 84h (Red Book addressing)
name       CODE:35EAF CD_PLAY_START
name       CODE:35EB3 CD_PLAY_LEN  ; in frames; 32200h's (3:34) when the next track's start is negative
; the attract mode's frame (2026-09-30, the code; the port against a run
; at CODE:298C5, the four tables)
code       CODE:2A4F8 ATTRACT      ; GAME_PHASE 1, a frame: state+2A7Fh 0, +0D70h 0, (+0EC5h set: cleared, CODE:26A6D a RET, LAST_KEY 0), FRAME_STEP, ATTRACT_SCROLL, CODE:156C3 (a RET), FLIPPERS_STEP, then the display (state+0E34h: 0 the display stream and animations, else the players' scores) and the keys
name       CODE:BAD6 PHASES        ; GAME_PHASE's routines (ten dwords; TABLE_CHECK the third)
code       CODE:29889 FRAME_STEP
name       CODE:2982E FRAME_ROUTINES ; the table of four routines FRAME_STEP calls (29912h, see CODE:29912)
name       CODE:BAD1 FRAME_DONE    ; 0 at FRAME_STEP's start, FFh from DRV_FRAME: the retrace has come
name       CODE:BAD4 FRAME_COUNT   ; a word, counted by DRV_TICK
code       CODE:298EF FRAME_MUSIC  ; MUSIC_UPDATE, registers 0, the driver's command 6 (CODE:9C0C)
code       CODE:29033 LIGHTS_DRAW  ; from LIGHTS_DRAW_POS, each light whose LIGHTS_ONE1 byte differs from LIGHTS_ONE2 (then copied): LIGHT_PIC n (byte not 0) or n + half the count (LIGHTS_SEL's first dword), and for the latter the loop's index itself moved on by the half (ADD ESI,EDX before PUSH ESI), so the lights between are passed over (presumably a slip; run 2026-09-30: LIGHTS_ONE2 from index 2 on not copied in the first frame); stops when FRAME_DONE is FFh, to go on from there
name       CODE:2909B LIGHTS_DRAW_POS
code       CODE:2909F LIGHT_PIC    ; LIGHTS_SEL's picture ESI (the dword table at the block's start; x, y, width, height, then the bytes) by LIGHT_SPRITE
code       CODE:29155 LIGHT_SPRITE ; the picture (SPR_W bytes a row a plane, the four planes after each other, 0 transparent) at byte SPR_X of line SPR_Y into SPOOKY_SEL's planes, then into video memory from 1500h where HIDELIGHTS_SEL's byte is 0
code       CODE:28F41 DROPS_UPDATE ; from DROPS_UPD_POS, the 64h entries of DROP_PIECES whose state changed: CODE:29101 (as DROP_PIC) 2n, or 2n - 1 for a state not 0, at the entry's x, y; stops as LIGHTS_DRAW
name       CODE:28FB6 DROPS_UPD_POS
name       CODE:285BC DROP_PIECES  ; 64h entries of 8 bytes: the state drawn, the state, x, y (words)
name       CODE:28F3D DROPS_DRAW_POS
code       CODE:9C4F SND_PAUSE     ; the driver's command 2 (CODE:9C5E the same)
code       CODE:9C5E SND_RESUME   ; the same as SND_PAUSE
name       CODE:9CA4 CD_LEVEL      ; the CD volume last given to CD_VOLUME
name       CODE:9CE5 JINGLE_ENDED
name       CODE:9DC5 TRACK_ON
name       CODE:9DC6 JINGLE_ON
name       CODE:CB98 MUSIC_FLAGS_KEPT ; state+5Ah
name       CODE:F5C2 MOD_REQUEST   ; state+2A84h
name       CODE:F5C6 MOD_REQ_ORDER ; state+2A88h
name       CODE:F5C8 MOD_REQ_SLOT  ; state+2A8Ah
name       CODE:35EF6 CD_CHANNELS  ; IOCTL output 3's block: inputs 0..3 to outputs 0..3, the volumes of 0 and 1 set by CD_VOLUME
; the balls' physics (2026-09-30, stage 2: read from the code; the roles
; of +28h, +32h, +6Ch checked by -watch in a NOSOUND run, table 1, F1 at
; t=150 and Enter at 153; the rest not run). A ball's record: +0Eh, +10h
; its speed; +1Eh, +22h its place shifted left by 0Ah (+12h, +14h the
; pixels); +28h the angle of the surface's normal at the last collision
; (800h a full turn); +0Ch the samples that hit; +2Eh, +30h, +2Ah, +2Ch
; the contact points; +32h the surface's number; +34h..+3Ah the surface's
; four words; +3Ch the slope added to the speed this frame; +1Ah, +1Ch a
; push from the surface; +4, +5 a bumper's or slingshot's number; +26h a
; spin (counted toward 0 a move)
name       CODE:1023E BALLS_PHYSICS ; a frame of the balls: four times (once with state+0FC5h set) each ball in play (byte +9 0, +1 not negative) BALL_COLLIDE and, when that is not negative, BALL_BOUNCE; then FLIPPERS_MOVE and BALLS_MOVE twice; FLIPPER_SOUNDS at the end. With no ball on the table FLIPPERS_STEP's four moves. The first pass sets each ball's +6Ch to FFFFh (no object). Runs in GAME_PHASE 4, 6, 7, 9 (its callers), so the waiting ball collides too (run: +28h written from t=150.29 in phase 6)
name       CODE:10540 BALL_COLLIDE ; [CODE:0010]'s +32h, +4, +5 cleared; BALL_SAMPLE; no hit or a lost ball: -1 (SF). A hit: the samples of BALL_RING summed through the tables CODE:10594 and 10674 (a sum of the angles of the hit samples, their count, flags by side), the mean angle to +28h and the count to +0Ch; the contact point +2Eh, +30h from CODE:168C9 by the last hit sample; the surface's number (+32h) from the ball's map at +50h (a line's four words by x in quarters of 54h, then a list of pairs at +12C0h searched by x); surface 20h and above: +6Ch = the number less 20h (the object OBJECT_HITS takes); below 20h: +34h..+3Ah from the 8-byte entry at CODE:C33E and the handler of CODE:1183F by the number; returns 0
name       CODE:1237C BALL_SAMPLE  ; the ball's +12h, +14h (below 0 taken as 0) plus NUDGE_X, NUDGE_Y; y above 258h: the ball lost (+9 FFh, BALL_PLACE, NZ). Each flipper of state+28FEh (1F7h bytes, byte +0 0 ends) whose box for its angle (+1Ah) holds the point gets +1F6h FFh, and when it is on the ball's level (+1Ch = the ball's +54h) its mask at angle (+6 + +1Ah) mod 78h is sampled (16 bytes a line, from [+28h]); else MAP_SAMPLE on the ball's map +54h. [CODE:0018] = CODE:12844 (14h zero bytes) either way; ZF when a sample hit
name       CODE:12864 MAP_SAMPLE   ; a ring of 17 lines (masks RING_MASKS: the edge of a circle of 17 pixels) at AX-7, DX of the map at ESI (a bit a pixel, 2Ah bytes a line) into BALL_RING, byte-swapped; any bit to CODE:12819
name       CODE:12BDC RING_MASKS   ; 17 dwords, a line's pixels of the ball's edge
name       CODE:25FC9 BALL_RING    ; 17 dwords: the ring's pixels that hit, from MAP_SAMPLE or a flipper's mask
name       CODE:1183F SURFACE_HANDLERS ; 20h words by the surface's number: 1..4 the flippers (CODE:1187F on: the flipper's +10h, its turn, handed on to the ball by the flipper's kind +1, table CODE:11AE9), 0Ah BALL_BUNDLE2 and 0Bh BALL_BUNDLE1 with the speed 0 and the sound record CODE:100B4 (onto the other level, presumably), 10h..15h CODE:122C1 (+4 = number less 0Fh: a bumper), 16h..1Fh CODE:122EA/122F8 by turns (+6 = 190h / FE70h, +5 = (number-16h)/2+1: a slingshot), the rest nothing; +4, +5 left 0 while state+2A75h (the tilt) is set
name       CODE:12C20 BALL_BOUNCE  ; the ball's speed plus the nudge's move (state+0D42h, 0D44h; clamped to F001h..0FFFh) turned into the normal's frame (+28h; COSINES and SINES, 4000h is 1), the push +1Ah, +1Ch taken in (at most FA0h off) and cleared; moving into the surface: the speed along the normal reversed, 0 when below +34h (or the push +38h); a bumper (+4, when the speed is FFCEh or less: 157Ch more, the record at state+28D6h's list: +1 6, the points +16h through CODE:2FD11, the stream +6 to EVENT_QUEUE, the sound +2) or a slingshot (+5, FF9Ch or less: 0DACh more and +6 across, state+28DAh's list, the same without the stream); the speed along the normal times +36h / 100h; across it: friction by +3Ah with the spin +26h; turned back, the nudge taken off again, clamped, to +0Eh, +10h. With +0Ch 6 or more the ball is also put out by 200h along the normal (>> 0Eh into +1Eh, +22h)
name       CODE:16981 SINES        ; 800h words (a full turn), 4000h is 1; COSINES is the same table a quarter on
name       CODE:16D81 COSINES
name       CODE:133BF BALLS_MOVE   ; each ball in play: the place (+1Eh, +22h) plus the speed x 32h / FRAME_RATE / 2, the pixels to +12h, +14h; the slope under its centre (the ball's map +5Ch, a byte per 8 x 8 pixels, lines by state+21E6h, into the vectors at state+28EEh) plus SLOPE_X (state+0E40h) and SLOPE_Y to +3Ch and, unless byte +3 is set, to the speed; the spin +26h a step toward 0; then against each later ball on the same level (+8) within 11h pixels both ways: BALLS_PAIR (CODE:13597) for each such pair
name       CODE:13597 BALLS_PAIR   ; ball [CODE:0010] against [[CODE:0008]] (CODE:0004): the pair's entry in CODE:24C19 (lines by dy through CODE:13760, 8 bytes by dx: a word, 0 for no contact; the case; the push x, y) pushes one of them apart (by the sign of dy) when the word is below 10h; the case (CODE:13784) shifts both speeds right by 4 and skips the pair unless they close in along x (cases 0, 3, 4, 7) or y (1, 2, 5, 6); the speeds turned through the product tables CODE:17F81, 1B381, 1E781 at the offset CODE:14493 gives for the low word of CODE:0034 (presumably sine and cosine, not checked); then each speed word less (same sign) or plus its turned part, A's new speed from B's turned speed plus A's own part, B's the other way (port/src/phys.c; compared in runs, docs/HANDOFF.md, "The ball-ball physics in the port")
name       CODE:10754 RING_SUM     ; BALL_COLLIDE's sum of BALL_RING's 17 lines (the first and last through the tables CODE:10594, 10674, the others bit by bit): each hit sample's angle to [CODE:0034], counters by quadrant in [CODE:0024]..[CODE:0030], side bits in [CODE:0038], its number in [CODE:003C]; flags 9, 0Bh, 0Dh (hits on both sides of angle 0) add 800h per fourth-quadrant hit; the mean angle to +28h (AND 7FFh), the count to +0Ch
; GAME_PHASE 6 (2026-09-30: the port against runs of tables 1, 3 and 4 at
; CODE:2B76E, docs/HANDOFF.md, "GAME_PHASE 6 in the port")
name       CODE:2B1DC BALL_WAIT    ; GAME_PHASE 6: BALL_SAVE = SERVE_SECONDS x FRAME_RATE, state+0D2Fh FFh (the skill shot armed), MUSIC_REQUEST with header slot 34's record; then frames (CODE:2B21E) of FRAME_STEP, CODE:2B49A, BALLS_PHYSICS, ZONES_CHECK, SERVE, "PLAYER n"/"PLAYERS n" and "BALL n", DM_SCORE_IDLE, FLASH_STEP, PLAYERS_KEYS until Esc (CODE:2B345) or state+0D3Ch 0 (zone type 0: GAME_PHASE 4)
name       CODE:2B3BE PLAYERS_KEYS ; while state+0D30h is set: the highest of F1..F8 pressed sets the players' count state+0D70h to its number, keypad Enter adds one; every F-key byte cleared on the way; the count at most 8
name       CODE:301C9 PLAY_SCROLL  ; the scroll in play: SCROLL_LINE toward the lowest ball's line (state+0D5Ch) less state+0D52h by the distance / state+0E3Ch (halved going up while SCROLL_LINE is 20h or less, and going down), 0..SCROLL_MAX; to ATTRACT_LINE, then CRT_NEXT_SET with SCROLL_ADD as ATTRACT_SCROLL ends
name       CODE:308E7 SLINGS_STEP  ; each frame (CODE:30784): the records of state+28DAh's list (word offsets from it, 0 ends; the slingshots, presumably: BALL_BOUNCE sets their byte +0 FFh): FFh becomes 2, a count above 0 goes down; at 0 (or from FFh) the picture +16h through CODE:28E7B
name       CODE:28E7B PIECE_SET     ; the DROP_PIECES entry of the object at [CODE:0000] (its dword +8 the index): the state from [CODE:0020]'s low byte, x and y the low words of the object's dwords +0, +4; DROPS_UPDATE draws it (in the port 2026-09-30)
name       CODE:12F26 BUMPER_KICK   ; BALL_BOUNCE with the ball's byte +4 (a bumper, n) set and the speed along the normal at or below -32h: that speed less 157Ch; the bumper's record (state+28D6h, word offsets from it, index n - 1), unless its byte +1 runs, +1 6, SCORE_ADD of +16h, its event stream +6 to EVENT_QUEUE, its sound record +2 to SFX_PLAY; CODE:0000, 0004, 000C, 0010, 0028 kept (run 2026-09-30, table 1: bumpers 3, 1, 2)
name       CODE:1302B SLING_KICK    ; the same for the byte +5 (a slingshot) and a speed at or below -64h: the speed less DACh, the ball's +6 (190h or FE70h, SURF_SLING) added to CODE:0028; the record's (state+28DAh) byte +0 FFh (its picture, SLINGS_STEP), then as BUMPER_KICK but no event stream (run 2026-09-30, table 1: slingshot 1)
name       CODE:2F2AF SERVE        ; a ball to serve (state+0D3Ah) while none waits (state+0D3Ch 0): onto the table (state+0D32h) and waiting (0D3Ch, 0D3Dh FFh), the sound record CODE:1009A; with state+0D3Dh set or Enter: the plunger (CODE:2F300)
name       CODE:2C3E7 ZONE_LEAVE   ; the object at the ball's +68h (set by zone type 1): its byte +0 cleared, +68h 0
; GAME_PHASE 4, play (2026-09-30: the port against a run of table 1 up
; to BALL_SAMPLE's flipper mask, CODE:1241E; docs/HANDOFF.md, "GAME_PHASE
; 4 in the port")
name       CODE:2B76E PLAY         ; GAME_PHASE 4, a frame: FRAME_STEP, PLAY_STEP; Esc GAME_PHASE 3 (CODE:2BAB5); state+0EC5h the first ball back to the plunger (BALL_PLACE; not run); unless state+0FC5h BALLS_PHYSICS and BALLS_LOST (none left: CODE:2B922); PLAY_EVENTS, PLAY_KEYS, DISPLAY_RUN, ANIMS_STEP; BALL_SAVE counted down, the lamp of header slot 25's second light state blinking (every 4th frame above 64h, every frame above 32h, off below: CODE:2B883); PLAYERS_KEYS; the tilt (state+2A75h) GAME_PHASE 9
name       CODE:2B49A PLAY_STEP    ; PLAY_SCROLL, LIGHTS_STEP, CODE:30784 (DROPS_QUEUE_STEP, SLINGS_STEP, HOLE_EJECT_STEP, DROPS_RAISE_STEP); CODE:156C3, 14DE1, 14C45 are RETs
name       CODE:2B4B9 PLAY_EVENTS  ; a frame's rules: ZONES_CHECK, OBJECT_HITS, EVENT_RUN, SERVE, FLASH_STEP, LIT_LIST_STEP, MODE_RUN, BCD_COUNTERS_STEP, COUNTER_TIMERS, OBJECT_TIMERS
name       CODE:2B4EC PLAY_KEYS    ; M (state+0E78h, scancode 32h) flips bit 0 of CODE:9C4E (not followed); P (state+0E5Fh, 19h) the pause (CODE:2B51C): DM_SAVE, SOUND_PAUSE, then frames of FRAME_STEP, PLAY_SCROLL and "GAME PAUSED" with "PRESS ANY BUTTON TO PLAY" / "PRESS ESC TO QUIT" by bit 8 of PAUSE_FRAMES, until a key (DM_RESTORE, SOUND_RESUME, state+0E5Fh 0) or Esc (PAUSE_QUIT); state+91h FFh
name       CODE:2B6C3 PAUSE_FRAMES ; the pause's frames, counted from 0; its bit 8 picks the second line of the pause's text
name       CODE:2B63B PAUSE_QUIT   ; Esc in the pause: "REALLY QUIT TABLE?" (CODE:2A93E) with the flippers stepped, until Y (state+8Dh FFh, out of PLAY_KEYS with state+0E5Fh still set) or another key (back to the pause)
name       CODE:2C0C7 BALLS_LOST   ; the balls on the table and to serve: each lost one (+9 set by BALL_SAMPLE) cleared, the sound record CODE:10080, swapped with the list's last, BALL_HIDE, CODE:2994A (150h bytes of video memory at D9E0h cleared), its erase place +70h DBD8h (CODE:2996F); state+0D32h one down, while BALL_SAVE runs state+0D3Ah one up; SF (the last ball gone) when state+0D32h reaches 0
name       CODE:2B9F6 LOST_RUNOUT
name       CODE:2D916 RECORD_TAKE  ; the slot-15 record at [CODE:0008] taken (event opcode 5, CODE:2CB03): see CODE:2D907
name       CODE:2DD8A COUNTER_LEVELS ; the slot-16 counter at [CODE:0000]: the player's count +16h against the 12-byte thresholds from +50h (a word, the players' bits +2, a light state +8 lit at the one reached, the ones passed put out when flag bit 1 is set; a negative word ends them, FFFEh: all passed, the count less its word +2, the stream +4Ch, the step and value reset, CODE:2DEEF); SF when none was reached. Run 2026-09-30, table 1: the threshold reached at the launch (CODE:2DE6C), the other paths not run
name       CODE:2CBCF OBJECT_TIMERS ; a frame: byte +1 of the records of header slots 12 and 13 (state+28D6h, 28DAh, word offsets) and byte +2 of the type-0 objects of slots 4 and 10 (state+28B6h, 28CEh; the lists end at the first 0) counted down to 0
name       CODE:2EAC9 BCD_COUNTERS_STEP ; a frame: the slot-26 counters (state+290Eh): one whose byte +0 is set has its step +22h (a 12-digit BCD number) added to (byte +1 bit 0: taken from) its value +2..+9 until it reaches or passes +12h..+19h, then the end value and byte +0 0. The bytes go as the code adds them: +6..+9, then +2, +3 (from +1Eh..+21h, +1Ah, +1Bh); a taken one ends on a borrow too (runs 2026-10-01: counters of tables 1 and 3 started by a poke, one subtracting, one adding; an invalid digit is carried on as DAA leaves it)
name       CODE:2ECCE LIGHT_QUEUE  ; the light state at [CODE:0008] to be flashed [CODE:0020] times by LIGHT_FLASH_STEP: unless its byte +2 bit 0 is set already, set and a 6-byte entry (the count, the light) onto the stack at state+17B8h (zone types 0 and 1: 0Ch times at the first entry, 8 when the player's bit was set already)
name       CODE:2FD11 SCORE_ADD
name       CODE:9F88 SFX_NOTE      ; a record of type 5 (RECORD_DISPATCH): unless SFX_CHECK refuses, the driver's command 7 on channel 4: CH the module slot +12h, CL the sample +14h, BL the note +6, BH the volume +4 (run 2026-09-30, table 3, from a zone's record)
name       CODE:11BE9 FLIP_KIND0   ; the eight flipper kinds (the flipper's byte +1, table CODE:11AE9) are one routine each, CODE:11BE9 + k x DBh, alike but for their table of eight bytes by the ball's normal's octant (CODE:11CBC + k x DBh): the flipper's turn [CODE:0028] doubled; with the turn not negative and the octant's byte set, or negative and the byte 0, the ball gets [CODE:0020], [CODE:0024] times the turn as its push +1Ch, +1Ah (the turn negated first in the first case, which also adds 3BBh to [CODE:0030]). Run 2026-09-30 (tables 1, 3, 4, no flipper pressed): kinds 0, 4 and 7 met; the push with the turn not negative (kind 0) and negative (kind 4)
; the balls' sprites (2026-09-30, the code; the port against a run at
; CODE:2A544, the four tables)
code       CODE:14C46 BALLS_SHOW   ; of the balls on the list (state+1046h, state+0D32h of them) the lowest on the stage (largest y below 258h; with more than one ball only those with byte +0Bh 0), from the first ball's place, to state+0D5Ah (x), +0D5Ch (y); then each ball BALL_DRAW and BALL_MARK
code       CODE:14DD6 BALL_HIDE    ; BALL_ERASE, BALL_UNMARK
code       CODE:2690E BALL_DRAW    ; the ball [0010] at +12h, +14h by the table's routine of BALL_DRAWERS (DS video memory, FS and GS the table's data, EBP the ball's +58h, EDI 1500h); DX, SI back to +6Eh, +70h
name       CODE:26957 BALL_DRAWERS ; four routines by TABLE_NUM: CODE:36320, 37F20, 39B20, 3B720
name       CODE:26967 BALL_ERASERS ; four routines by TABLE_NUM: CODE:371A0, 38DA0, 3A9A0, 3C5A0
code       CODE:26977 BALL_ERASE   ; the ball [0010] taken off at +6Eh, +70h (nothing when +70h is 0) by the table's routine of BALL_ERASERS (ES video memory, GS SPOOKY_SEL)
code       CODE:269B0 BALL_UNMARK  ; BALL_MASK with 0 at the ball's +72h
code       CODE:269D7 BALL_MARK    ; +72h = +14h x 150h + +12h, BALL_MASK with 80808080h there
code       CODE:2600D BALL_MASK    ; EAX in the ball's shape into HIDELIGHTS_SEL's block (DS) at EDI / 4 by the routine of BALL_MASKS for EDI AND 3 (each 92 MOVs of AL, AX or EAX to [EDI+d])
name       CODE:268FE BALL_MASKS
code       CODE:36320 BALL_DRAW1   ; table 1's ball, a compiled sprite: for the pixels' bytes in each plane (map mask by x AND 3, a bit a pixel in the byte at EBP + the address / 2 tested with AH = 80h >> (x AND 7)) MOV BYTE PTR [ESI+d],colour where the bit is 0; the port runs it from the image (codeint.c); 816 instructions, as each of the four
code       CODE:37F20 BALL_DRAW2
code       CODE:39B20 BALL_DRAW3
code       CODE:3B720 BALL_DRAW4
code       CODE:371A0 BALL_ERASE1  ; table 1's: the ball's bytes put back from SPOOKY_SEL's copy (planes C4E0h apart), 512 instructions, as each of the four
code       CODE:38DA0 BALL_ERASE2
code       CODE:3A9A0 BALL_ERASE3
code       CODE:3C5A0 BALL_ERASE4
name       CODE:288DC DROP_STATES  ; 64h entries of 8 bytes: the state, the state drawn, the object (DROP_SET, DROPS_DRAW)
; the attract mode's display (2026-09-30, the code; the port against a
; run at the first display opcode, the four tables)
name       CODE:2F621 DISPLAY_OPTAB ; a dword a display opcode (0 the end, then DISPLAY_OPCODES): the routine's offset from DISPLAY_OPCODES, the opcode's length in bytes (a word each)
name       CODE:2F35B DISPLAY_BUSY  ; FFh after DISPLAY_RUN ran (or waited); 0 when the idle display was put up (CODE:2F5E9)
name       CODE:27A7D ANIMS_BG_ONLY ; ANIMS_STEP: FFh when no animation plays (state+2A50h 0)
comment    CODE:27A62 the background animation (state+2A5Ch) +12h from +22h, +16h 0, also when there is none: through EBX 0 at CODE:0012 and 0016 (the CMP's flags are tested after, both ways to the RET; presumably a slip)
code       CODE:2A7FD ATTRACT_KEYS  ; Esc (state+0E47h) to CODE:2A8AB; else the first of F8..F1 (state+0E88h down to 0E81h) set, or keypad Enter (state+0EE2h) as F1: cleared, GAME_PHASE 2, the key's number (1..8) added to state+0D70h
; a game's start (2026-09-30, the code; the port against runs with F1 at
; GAME_PHASE 6's routine, the four tables; table 2 at the slot-40 call)
code       CODE:2A976 GAME_START    ; GAME_PHASE 2: BALLS_PER_GAME to state+0D36h, state+0D38h and the player (0D72h) 0, its bit (0D74h) 1, the eight player records from state+0D7Ah (16h bytes; 0D76h the first) cleared; BALLS_RESET, LIGHTS_RESET, COUNTERS_RESET, RECORDS_RESET, DROPS_UP_ALL, DISPLAY_RESET; state+0D32h 1, 0D3Ch FFh, 0D3Dh 0, 0D3Ah 0, 0D30h FFh; SFX_PLAY of CODE:1009A; state+2A7Fh FFh; the module's slot 40 (state+2946h, at CODE:2AA6D); state+2A78h 0, GAME_PHASE 6
code       CODE:29AB3 BALLS_RESET   ; the 13 balls (state+10AEh) put at the plunger (BALL_PLACE), bytes +1, +9, +0Bh 0
code       CODE:29ED6 RECORDS_RESET ; header slot 15's records (state+28E2h): +1, +2 0; with bit 1 of +0 lit (+1 FFh, +2Eh FFFFh, the lamp +4 on for the player's bit) and on the lit list (bit 2, state+2A32h first, 2A36h last, +30h next), else bit 2 and +30h cleared; then STREAMS_RESET
code       CODE:29E45 STREAMS_RESET ; the event ring (state+2A1Eh to CODE:F618, its first dword 0; state+2A1Ah, 2A1Ch, 2A22h 0), the mode stream's cells state+0D4Fh..0D6Bh and the display's state+2A58h, 2A5Ch 0 (the end of CODE:29CE3 and RECORDS_RESET)
code       CODE:29FFA COUNTERS_RESET ; header slot 16's counters (state+28E6h): +30h, +34h from +28h, +2Ch, the eight players' words +6 and +16h to +2, +38h, +3Ch, +26h 0, each threshold's byte +2 0; header slot 17's lists (state+28EAh): bit 1 of each 8-byte entry cleared, up to one whose word +2 is 100h or more
; the high-score pages and the numbers on the display (2026-09-30, the
; code; the port against runs at CODE:2A7D4 and at CODE:2A6C1's second
; call, the four tables)
code       CODE:2A6FA HISCORE_PAGES ; ATTRACT when state+0E35h is negative (set FFh with HISCORE_PAGE and HISCORE_WAIT 0 when the attract record has ended): with HISCORE_WAIT 0 the display cleared, the entry HISCORE_PAGE of TABLE_HISCORES (state+0CFCh, 10 bytes: the initials, a 0, the score's high word, its low dword) drawn, its number by DM_HISCORE_DRAW (centred at x 140h, line 2, font 1), place and initials by HISCORE_TEXT, HISCORE_WAIT 3 x FRAME_RATE; else HISCORE_WAIT counted down, at 0 the next entry, after the fifth state+0E35h 1 (the attract record queued again)
name       CODE:2A6E4 HISCORE_PAGE  ; the high-score entry shown, 0..4
name       CODE:2A6E6 HISCORE_WAIT  ; the frames left of a high-score page
name       CODE:2A968 HISCORE_TEXT  ; a text record (x 0, line 2, font 1, alignment 0): the place ('1' + HISCORE_PAGE, at CODE:2A970), a space, the initials (CODE:2A972..2A974)
code       CODE:27783 DM_TEXT_DRAW  ; the text record at CODE:0000 (words x, y, font, alignment, the text 0-ended) into DM_TEXT; CF for an alignment other than 0, 1, 2
code       CODE:275D7 DM_HISCORE_DRAW ; DM_BCD from a high-score entry (CODE:0000 its end) by DM_BCD_HISCORE, then as DM_SCORE_DRAW
code       CODE:275E4 DM_SCORE_DRAW ; DM_BCD from a player's number (CODE:0000 its +8) by DM_BCD_SCORE; at CODE:275EF DM_BCD as decimal text without leading zeros (one digit at least), a comma before each three, built back from CODE:27710, the record's words from CODE:002C, 0030, 0034, 0038, DM_TEXT_DRAW; CF (nothing drawn) at a nibble above 9
code       CODE:2758B DM_SCORE_IDLE ; the current player's score (state+0D76h) by DM_SCORE_DRAW, centred at x 140h, line 2, font 1 (3 when the record's word +0 is not 0); the idle display (CODE:2F5E9, not reached in runs)
code       CODE:2754C DM_BCD_HISCORE ; DM_BCD: 0, 0, [EDI-5], [EDI-6], [EDI-1] .. [EDI-4]
code       CODE:2750D DM_BCD_SCORE  ; DM_BCD: 0, 0, [EDI-7], [EDI-8], [EDI-1] .. [EDI-4]
name       CODE:26ECB DM_BCD        ; 8 bytes, the number DM_SCORE_DRAW writes, packed BCD from the highest digits
; the table's module (2026-09-30, the code and docs/bpc-module.md; the
; port against a run at CODE:911F, table 1)
code       CODE:B22D TABLE_MODULE  ; TABLE_HISCORES 0, MODULE_NAME's digits from TABLE_INDEX + 1 by DEC_TEXT and its ".bpc", MODULE_LOAD (CF), OPTIONS_APPLY, BALLS_ON_TABLE 1, TBL_DBF5 0, the module's slot 39 called (a RET in all four), HISCORES_GET (its CF not looked at)
name       CODE:CC22 TABLE_INDEX   ; the table 0..3 (TABLE_DIGITS), read as a word here and as a byte by HISCORES_GET
name       CODE:DBF5 TBL_DBF5      ; a byte cleared by TABLE_MODULE (who reads it not followed)
name       CODE:BBA3 MODULE_NAME   ; "source\t00n.bpc", later ".rel"
name       CODE:BBAF MODULE_EXT    ; its extension, "bpc" or "rel"
code       CODE:B3F5 MODULE_LOAD   ; MODULE_NAME ("table bin file", INT 94h AH=1) into MODULE_SEL, MODULE_SIZE, MODULE_BASE; ".rel" ("... relocation table") with policy 1 into MODULE_REL_SEL, RELOCATE; the header's 2Dh dwords (read through MODULE_SEL) to MODULE_HEADER, one with bit 31 set a resource's name loaded ("DATALOAD", its selector added to BLOCKS; bit 30 too: two names joined, CODE:B5B6) and replaced by its DS offset, in the header and by REL_REPLACE in the module. CF with AL 1..4 on a failed file; after a resource's failure the RET takes the pushed dword (not followed)
name       CODE:A10D MODULE_SEL
name       CODE:A10F MODULE_SIZE
name       CODE:A11D MODULE_BASE   ; the module's DS offset (INT 93h AH=0Bh less TABLE_BASE)
name       CODE:B725 MODULE_REL_SEL
name       CODE:F3E4 MODULE_HEADER ; the relocated header, 2Dh dwords (docs/bpc-module.md)
code       CODE:B743 RELOCATE      ; FS:ESI ECX dwords, each an offset in the module whose dword gets EBX (MODULE_BASE) added; FS, ESI, EBX, ECX kept in REL_SEL .. REL_COUNT for REL_REPLACE
name       CODE:B735 REL_SEL
name       CODE:B737 REL_START
name       CODE:B73B REL_BASE
name       CODE:B73F REL_COUNT
code       CODE:B768 REL_REPLACE   ; each relocated dword equal to EDX set to EAX
name       CODE:B5B2 DATALOAD2_KEY ; the header's value for two joined files (bits 31, 30 cleared), what REL_REPLACE replaces
name       CODE:B721 DATALOAD2_TEMP1 ; the first file's selector ("TEMP DATALOAD 1", policy 1), freed after
name       CODE:B723 DATALOAD2_TEMP2 ; the second's ("TEMP DATALOAD 2")
code       CODE:B366 HISCORES_GET  ; the table's 32h bytes of HISCORES (TABLE_INDEX) to TABLE_HISCORES; CF when its first byte is 0
code       CODE:B3A1 HISCORES_PUT  ; the other way, when they differ, and INT 94h AH=6 EDX 9Dh: OPTIONS' 200h bytes stored back into the configuration file, chained as AH=7 reads them, its header left (run 2026-10-01, docs/HANDOFF.md "The high scores' file"; in the port)
name       CODE:D83A TABLE_HISCORES
code       CODE:30368 DEC_TEXT     ; host vector +18h (see the comment there)
name       CODE:30581 DEC_BCD      ; the BCD word DEC_TEXT adds up
name       CODE:305E3 BIN_BCD      ; the low three nibbles of [CODE:0020] as decimal: BCD through DEC_ONES, DEC_SIXTEENS, DEC_256S into BIN_BCD_WORD ([CODE:0000] the place, [CODE:0004] the table's entry), the BCD word to [CODE:0020]'s low word (display opcodes 5, 9, 0Eh; run 2026-10-01 through opcode 9)
name       CODE:30782 BIN_BCD_WORD
name       CODE:1015E DM_SMALL_NUMBER ; the word before [CODE:0000], AND 0FFFh, through BIN_BCD into SMALL_NUMBER's low word (the dword before, 0) and drawn by DM_SCORE_DRAW with [CODE:0000] = DM_SMALL_NUMBER_BE (which it reads 8 bytes back from)
name       CODE:1010A DM_SMALL_NUMBER_BE ; as DM_SMALL_NUMBER with the word's bytes swapped first (display opcodes 5 and 0Eh; not run)
name       CODE:10102 SMALL_NUMBER
name       CODE:30585 DEC_ONES     ; BCD words 1..15
name       CODE:305A5 DEC_SIXTEENS ; BCD words 16..240
name       CODE:305C5 DEC_256S     ; BCD words 256..3840
code       CODE:2837D DM_FREE      ; CODE:27136 (the five fonts, DM_TEXT, DM_TEXT_TEMP freed) and CODE:2793C (DM_ANIMS_SEL, DM_ANIM, DM_ANIM_TEMP freed)
code       CODE:28388 DM_SAVE      ; DM_ANIM_SAVE and DM_TEXT_SAVE (all registers kept): the display's buffers into their temps (the pause)
code       CODE:283A3 DM_RESTORE   ; DM_ANIM_RESTORE and DM_TEXT_RESTORE: the buffers back from their temps
code       CODE:279D2 DM_ANIM_SAVE ; DM_ANIM's 1400h bytes to DM_ANIM_TEMP
code       CODE:279F0 DM_ANIM_RESTORE ; DM_ANIM_TEMP's 1400h bytes to DM_ANIM
code       CODE:2721D DM_TEXT_SAVE ; DM_TEXT's 1400h bytes to DM_TEXT_TEMP
code       CODE:2723B DM_TEXT_RESTORE ; DM_TEXT_TEMP's 1400h bytes to DM_TEXT

