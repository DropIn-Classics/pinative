name       CODE:A2BB TABLE_JUMP    ; a far pointer: CODE:A39C and CS's alias
name       CODE:A2C1 TABLE_BACK    ; a far pointer: CODE:A4A9 and TABLE_OLD_CS
name       CODE:A2C5 TABLE_OLD_CS  ; the caller's CS (run: 14h)
name       CODE:A311 TABLE_NUM     ; the table 1..4 (TABLE_DIGITS)
