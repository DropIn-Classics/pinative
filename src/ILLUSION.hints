name       CODE:A121 BLOCKS_END
name       CODE:A125 BLOCKS
code       CODE:A5BF ALLOCS_INIT   ; the same for ALLOCS_END, ALLOCS (the joined resources' allocations, presumably: docs/bpc-module.md, "Module entry and lifetime")
