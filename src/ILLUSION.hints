name       CODE:A320 TABLE_OLD_DS  ; the caller's DS (run: 1Ch)
name       CODE:A322 TABLE_ARG     ; AL at TABLE
name       CODE:A10B TABLE_DS      ; DS's alias, DS while the table runs
