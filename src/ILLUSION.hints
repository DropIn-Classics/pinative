; ILLUSION.386, the main program: a pMAX flat image, unpacked from the
; archive in ILLUSION.EXE by tools/illfiles.py (extract --all).
pmax       build/files/ILLUSION.386
segment    CODE 0 CODE             ; descriptor 0: the whole image, code and data
segment    TAIL 1 BSS              ; descriptor 1: base at the image's end, size 0; its use not known

name       CODE:02A3 ENTRY         ; the header's entry point
comment    CODE:02C7 INT 93h AH=11h: presumably the command tail (DS:EDX); its first word goes to CODE:086C
comment    CODE:02FF INT 94h AH=8 with CX:EDX = CODE:086C: the configuration file (run 2026-09-29: "ILLUSION.CFG" as the argument is opened, created when missing; none: "Error while initializing configuration file")
comment    CODE:35B34 INT 2Fh AX=1510h, MSCDEX device request, the header copied to real-mode memory first
comment    CODE:35B52 INT 2Fh AX=1500h, MSCDEX installed? drive letter to CODE:3631B (no MSCDEX: "CD error!")
comment    CODE:35C58 IOCTL input: audio disk info, then track info for each track to CODE:35F1B (run with -cue: 0Ah, then 0Bh for tracks 1..51)
code       CODE:35B0D CD_REQUEST   ; EBX = a request header in the image, copied to real-mode memory for INT 2Fh AX=1510h
code       CODE:35C09 CD_VOLUME    ; IOCTL output (command 0Ch), BL to CODE:35EF8 and 35EFA: the audio channel control (IOCTL 03h), channels 0 and 1 at volume BL, 2 and 3 at 0 (runs 2026-09-29 with -cd: 00 at each negative request, C0h at a track's start and a jingle's end)
name       CODE:35F1B CD_TRACK_START ; a dword a track, by its number (run: track 2's read at +8 when table 1 starts)
code       CODE:35DDC CD_PLAY      ; EBX = the track: the play request at CODE:35EA1 from its start to the next track's; ECX back = its length (run: "play frames 24470..38187 (track 2)" for EBX=2)
code       CODE:35E4F CD_STOP      ; the request at CODE:35E94 (command 85h, stop audio)
code       CODE:9D83 MUSIC_TRACK   ; stops the CD and plays track EBX; when bit 0 of CODE:CB97 is set, the length times [CCB8E] / 75 to CODE:9DBD, counted down at CODE:9CEA, which plays the track again at 0 (run, table 1: again after 159.3 s of a 182.9 s track: FRAME_RATE is 61 while the frame step, which counts, runs 70 times a second in the runner; 182.9 x 61/70 = 159.4)
comment    CODE:9BCA the table's first music record ([CODE:F470], header slot 35 of the table module): its word +8 the CD track, its byte +0Ah to CODE:CB97 (runs: tracks 2, 0Eh, 1Ah, 27h for tables 1..4, the byte 1 for all four)
code       CODE:2F85C MUSIC_REQUEST ; [CODE:0000] = an audio record of the table module (12 bytes, word +0 = 4): its word +8 to MUSIC_NEXT, its byte +0Ah to CODE:CB97 (state+59h); while LOST_BALL_RUNOUT is set only the byte, with bit 1 added (bit 1 is read by no instruction: the readers of state+59h are CODE:9D99 TEST 1, 9E9A TEST 4, the OR at 2F89A and the copy to +5Ah at 2F8E3, by the code and in runs 2026-09-29, -rwatch; so byte +0Ah 2 in a record has no effect found either); then its word +2 to state+2A84h (CODE:F5C2), +4 to +2A88h, +6 to +2A8Ah: the sound driver's request (CODE:9E83), +4 the order index, +6 the module slot; word +2 negative (FFFEh, FFFFh): first state+59h (the byte just stored) to +5Ah, which CODE:9DED puts back into +59h when a jingle ends, and MUSIC_NEXT to +2A82h (read by no one found)
name       CODE:F5BE MUSIC_NEXT    ; state+2A80h: a track asked for; CODE:9E13 plays it through MUSIC_TRACK when not 0 and sets it to 0 (runs, table 1: only 0 written in a game of three balls)
name       CODE:CB8E FRAME_RATE    ; state+50h: frames a second, what the waits of the event and display streams are multiplied by; set by the display mode (CODE:910E) and then by CODE:9265 (run 2026-09-29, table 2: 46h at t=118.31 by CODE:979A, 3Dh at 118.34 by CODE:92C7)
name       CODE:9265 MEASURE_RATE  ; one vertical retrace timed with PIT channel 0 (mode 0 from 0): 1234DCh / the ticks, at most 3Dh, to FRAME_RATE; so a 70 Hz mode counts 61 frames a second, and a game second lasts 61/70 s (runs: a track's replay after 159.3 s of 182.9, track 19's return after 16.6 s of 19.1)
comment    CODE:910E the display mode's routine by OPT_RESOLUTION, in the options screen's order: CODE:9743 VGA 360x350 (FRAME_RATE 46h; the runs' mode), 97A4 SVGA 640x480 and 9822 SVGA 800x600 (both INT 10h AX=4F02h, VESA, 3Ch), 96E7 VGA 320x240 (3Ch); CODE:9265 is called after it
name       CODE:009D OPTIONS       ; 200h bytes, read at CODE:0310 (INT 94h AH=7), cleared and written by the R option (CODE:32F16); the options screen's settings, one byte each in the screen's order (CODE:32C22 picks each line's text from SETSOUND.DAT by it, CODE:32C7C steps it by Enter, wrapping at the counts 2, 5, 3, 4, 2, 4 at CODE:32DE3): +0 balls per game (0 THREE, 1 FIVE), +1 OPT_ANGLE, +2 OPT_SCROLLING, +3 OPT_MULTIBALL, +4 OPT_TILT, +5 OPT_RESOLUTION; +6 a video mode number for the SVGA modes (CODE:0753, MODE_SVGA640), not a line of the screen, not followed (run 2026-09-29: all 0 with the GOG ILLUSION.CFG)
name       CODE:009E OPT_ANGLE     ; table angle: 0 NORMAL, 1 HIGH, 2 VERY HIGH, 3 VERY LOW, 4 LOW (to SLOPE_Y by OPTIONS_APPLY)
name       CODE:009F OPT_SCROLLING ; scrolling: 0 MEDIUM, 1 SMOOTH, 2 FAST (to SCROLL_DIVISOR by OPTIONS_APPLY)
name       CODE:00A0 OPT_MULTIBALL ; multiball maximum: 0 SIX, 1 THREE, 2 FOUR, 3 FIVE (read by CODE:B0E3 only)
name       CODE:00A1 OPT_TILT      ; tilt sensitivity: 0 NORMAL, 1 EARTHQUAKE (to TILT_STEP by OPTIONS_APPLY)
name       CODE:00A2 OPT_RESOLUTION ; 0 VGA 360x350, 1 SVGA 640x480, 2 SVGA 800x600, 3 VGA 320x240 (the options screen's list; run 2026-09-29: Enter on RESOLUTION wrote 1 by CODE:32C91 and the screen showed SVGA 640x480)
; the options in a game (2026-09-29; readers from a run on table 1, a game
; of three balls, doskit's -rwatch on CODE:D976, 0Eh bytes, and a search of
; build/ILLUSION.ASM for the field offsets; not in the table modules)
code       CODE:B2E0 OPTIONS_APPLY ; called once as a table is loaded (CODE:B272): the option bytes through the word tables at CODE:B2C0.. to the state words BALLS_PER_GAME .. RES_CODE
code       CODE:B0E3 MULTIBALL_CAP ; (from CODE:B0D8, the table's loading) the table's two numbers at CODE:B14E + 8 x (CODE:A311 - 1) (CODE:A311 the table's number 1..4, presumably, not checked; table 1: 6, 4; 2: 0, 0; 3: 6, 0; 4: 4, 6), each lowered to 6, 3, 4, 5 by OPT_MULTIBALL and written, when not 0, to word +2 of the records the module header's +0ACh and +0B0h point to: the table's multiball sizes, presumably (not checked in a run)
name       CODE:D976 BALLS_PER_GAME ; state+0E38h: 3 or 5 (OPTIONS+0); copied to state+0D36h at the game start (CODE:2A97C) and compared with it at zone type 0 (CODE:2C5EA)
name       CODE:D978 SLOPE_Y       ; state+0E3Ah: 3, 4, 5, 1, 2 by OPT_ANGLE (so VERY LOW 1 .. VERY HIGH 5); added each frame to the second word of the vector at [EDI] for a ball (CODE:134FF) and set in the balls' records at +3Eh (CODE:B7CC): the pull down the table, presumably (the run: read 23,690 times from the serve on)
name       CODE:D97A SCROLL_DIVISOR ; state+0E3Ch: 3, 5, 1 by OPT_SCROLLING (MEDIUM, SMOOTH, FAST); CODE:30203 divides a distance by it (the run: 3165 reads, one a frame of play): a scroll step of a third, a fifth or all of the way, presumably
name       CODE:D97C TILT_STEP     ; state+0E3Eh: 100 (64h) NORMAL, 0 EARTHQUAKE; CODE:14C06 adds it to state+2A78h on a nudge key's new press (Space, Left Alt, Right Alt: the bits of state+2A77h), state+2A78h falls by 1 a frame, and at C8h or more state+2A75h is set (the tilt: header slot 38, CODE:2B8ED); the add and the compare come before the fall of the same frame, so NORMAL tilts at the third nudge within 100 frames of the first, EARTHQUAKE never (by the code; the run had no nudge, no read; the mask state+2A76h not followed)
name       CODE:D97E SLOPE_X       ; state+0E40h: always 0; the first word's counterpart of SLOPE_Y (CODE:134F2, B7C1)
name       CODE:D980 SERVE_SECONDS ; state+0E42h: always 0Ah; times FRAME_RATE to state+0D3Eh when the ball waits for its launch (GAME_PHASE 6, CODE:2B1E8); what counts it down not followed
name       CODE:D982 RES_CODE      ; state+0E44h: 1, 2, 3, 0 by OPT_RESOLUTION; read only by event opcode 19h (CODE:2D35E), which asks for 5
num        CODE:B7C1
num        CODE:B7CC
num        CODE:134F2
num        CODE:134FF
num        CODE:14C06
num        CODE:2A97C
num        CODE:2B1E8
num        CODE:2C5EA
num        CODE:2D35E
num        CODE:30203
code       CODE:32F39 SETUP_ARGS   ; the language of SETSOUND.DAT's texts by INT 93h AH=15h (AX 'SV' 2, 'GR' or 'SG' 1, else 0: English, German, Swedish by the file's texts) to CODE:331BF; then the command tail from its first '/', at most 20h characters, upper-cased: S the sound set-up (CODE:32970), O the options screen (CODE:32DA7), R the options cleared (CODE:32F16), '?' the help text and CF set (runs 2026-09-29: '/?' printed it and exited with 32; '/o' showed "Pinball Illusions Options"). No S and no configuration yet (INT 94h AH=5, or FFFFFFFFh): the sound set-up as well
; names for the routines found so far (2026-09-29; what each does is in
; its comment above, and docs/HANDOFF.md; a name says no more than that)
name       CODE:29889 FRAME_STEP
name       CODE:14DE2 BALLS_STEP
name       CODE:9DC7 MUSIC_UPDATE
comment    CODE:9DC7 every frame (CODE:298EF, with the driver's command 6 after it): a jingle's end (CODE:9CE5 set by the completion routine CODE:9CD4) clears it and CODE:9DC6 (a jingle playing, set at CODE:9E83); while a track plays (CODE:9DC5, set at CODE:9E13, cleared at CODE:9D3C and by a negative request) the byte of CODE:CB98 (state+5Ah) back to CODE:CB97, CD volume C0h, the driver's level 0 (CODE:9C1A) (run 2026-09-29, table 1, track 4 playing: jingles ended at t=149.27 and 154.15, CD volume C0h 12 and 13 ms after)
comment    CODE:9C1A the driver's command 0Ch (a global level, docs/audio-driver.md) with 0: the module music silent while a CD track plays; CODE:9C34 with 100h before a jingle
comment    CODE:9C4F the driver's command 2, twice around each CD request (CODE:9C4F and 9C5E are the same): SB16.SDR's pause and resume, DMA channel masked then unmasked (driver +8B0, +8A2)
name       CODE:9CEA MUSIC_COUNTDOWN
name       CODE:2C1DA ZONES_CHECK
name       CODE:2D080 EVENT_RUN
name       CODE:2CD3C MODE_RUN
name       CODE:2F35C DISPLAY_RUN
name       CODE:2FEDB DISPLAY_QUEUE
name       CODE:2D18F EVENT_OPCODES
name       CODE:2F625 DISPLAY_OPCODES
name       CODE:2DA0A TAKE_HANDLERS
name       CODE:3007A RECORD_DISPATCH
name       CODE:2FBBF TAKE_PAY
name       CODE:2BD95 BONUS_ADD
name       CODE:2A4B1 BONUS_CLEAR
name       CODE:4FF9 CHOOSER
name       CODE:B9B9 DRV_FRAME
name       CODE:9743 MODE_VGA360
name       CODE:97A4 MODE_SVGA640
name       CODE:9822 MODE_SVGA800
name       CODE:96E7 MODE_VGA320
; Esc on a table (2026-09-29; run on table 1, see docs/HANDOFF.md, "Esc")
name       CODE:CBCC GAME_PHASE    ; state+8Eh: the number by which CODE:BAD6's routines are called each round (CODE:B993). Run 2026-09-29 (table 1, a game of three balls, -watch): 1 attract mode (CODE:2A4F8); F1: 2 game start (2A976), at once 6 the ball waits for its launch (2B1DC, "PLAYER 1 BALL n"); Enter: 4 play (2B76E); 7 a lost ball served again while the ball save runs (2BAD5, "DON'T MOVE"; from CODE:2B946), back to 4 after about 1.3 s; 5 the ball lost (2BBC6, the bonus, "NO BONUS"), then 6, or 8 for an extra ball (2BB3E, "EXTRA BALL"; seen with the player's byte +10h poked: set by 2BC0B, 4 again by 2BBA8 at the Enter that launches the ball), or after the last ball 3 game over (2AA90, "GAME OVER"), then 1. Esc during play 3 (CODE:2BAB5), Esc in phase 6 1 (CODE:2B345). 0 (CODE:BAFE) and 9 (2B716, set at CODE:2B8ED, near the text "TILT": a tilt, presumably) not seen
name       CODE:CBCB QUIT_TABLE    ; state+8Dh: FFh leaves the table for the chooser (run: written by CODE:2BABB at t=140.01, Esc during play; the chooser's screens followed)
comment    CODE:2A8AB Esc in the attract mode: the text "REALLY QUIT TABLE?" (CODE:2A93E) while the frame step goes on, until KEY_DOWN+15h (scan code 15h, Y on a QWERTY keyboard: yes, QUIT_TABLE FFh) or another key (LAST_KEY; on with the attract mode) (run: Esc at t=124 showed the text, Space at 127 went on; Y not tried there)
comment    CODE:2B63B the same question for Esc at CODE:2B56D (the routine at CODE:2B543, its callers not followed; presumably while the ball waits for its launch, not run): Y QUIT_TABLE FFh, another key back to CODE:2B543
name       CODE:2BAD3 LOST_BALL_RUNOUT ; FFh while CODE:2B9F6 runs the streams out after a lost ball; read only by MUSIC_REQUEST (run 2026-09-29, -rwatch)
comment    CODE:2B9F6 a lost ball without the ball save (from play at CODE:2B946 when the ball save's count state+0D3Eh is 0, and from GAME_PHASE 9, CODE:2B716; both after CODE:2C0C7 comes back negative): state+0D51h and LOST_BALL_RUNOUT FFh, then frames stepped here until the two event streams (state+2A28h/2A2Ah, 2A1Ch/2A1Eh) and the mode stream (state+0D5Eh) are empty; then both 0 and GAME_PHASE 5. Runs 2026-09-29, table 1, no flipper: with no stream running FFh for 14 ms (t=155.951 to 155.965); with START MODE forced as in HANDOFF's "A mode's track in a run", the ball lost at t=148.494 during the mode, the mode's closing record (the one its timer brings at t=197.3 when no ball is lost) through MUSIC_REQUEST's bit-1 branch at t=148.621; that the mode stream gets there through state+0D51h (CODE:2CD3C) is presumed, not traced
comment    CODE:2BAB5 Esc during play (CODE:2B76E): QUIT_TABLE FFh and GAME_PHASE 3 at once, no question (run: Esc at t=140 in a game, the screen dark at 141, the chooser's table menu after Space at 144; Esc there at 150: "Thank you for playing Pinball Illusions CD." and exit code 32)
comment    CODE:9D3C the track's time up, a return set: CD volume 0, the driver's command 8 with the order index and slot of CODE:9CE6/9CE8 (run 2026-09-29, table 2: at t=151.03, after track 19 of the music chooser)
comment    CODE:9E13 a track in MUSIC_NEXT: the record's order index and module slot kept in CODE:9CE6/9CE8 (the module music to return to), the module request cleared, the track played, CD volume C0h; when its time is up (CODE:9CEA) the driver's command 8 with them, the CD volume 0 (9CE6 0: the track again)
comment    CODE:9E83 the module request (state+2A84h): positive (1, 2, 3, 6, 7, 8 in the four modules' slot-34 records; only the sign is read, by this CMP) the driver's command 0Ah (temporary module playback, docs/audio-driver.md: a jingle in place of the module's music, which then goes on from where it stopped; run 2026-09-29, table 1, record 11F15h's words poked here: 1.78 s, the 89 ticks of music2.mod's pattern 14 at 50 Hz) with BX the order index, CX the module slot, the CD volume 0 first when bit 2 of CODE:CB97 is set (byte +0Ah 4 in 12/20/18/0 of the jingle records of tables 1..4; run 2026-09-29, table 1 with track 4 playing: CD volume 0 at t=151.434, C0h again at the jingle's end, t=154.162, CODE:9DC7); negative: CD volume 0, the track's countdown CODE:9DBD stopped (-1), command 8 (the module from that order index); 0: nothing
comment    CODE:9B76 module slots 0 and 1 loaded above from CODE:98D5 and 98E9 (data\s00n\music.mod and music2.mod, the digit at CODE:98DD/98F1; slot 1 not when CODE:A311 is 4); command 8, order index 1 of slot 0: the module music at a table's start
comment    CODE:2B345 the module request without a record: order index 1, slot 0, word FFFEh (state+8Eh = 1)
comment    CODE:2ABA4 the score (CODE:0020/0024) against the list of 10-byte entries at state+C0CFCh: the first time an entry is passed, header slot 37's record (tracks 8, 18, 34, 48 for tables 1..4); presumably the high-score music, not reached in runs
comment    CODE:2AA90 header slot 36's record (track 0, byte +0Ah 2 in all four tables; run, table 1: once, at t=193.8, what happened then not looked at)
comment    CODE:2B1DC header slot 34's record, record 0 (track 0; run, table 1: at t=130.0, the F1 start, 135.8 and 147.2)
comment    CODE:2B8ED header slot 38's record while state+2A75h is set (track 0 in all four tables); runs every frame in a game
comment    CODE:3007A by the type of the record at [CODE:0000] (its first byte AND 7): 4, an audio record, to MUSIC_REQUEST; 2 to CODE:9F2C (run, table 1: record 42, track 0, came from none of the other callers logged; this way, presumably)
; the tracks of the table's modes (2026-09-29, from the four modules' data
; and the handlers below; no such play seen in a run yet)
comment    CODE:2D9DE the word +2Ch of the slot-15 record at [CODE:0008] picks one of the handlers at CODE:2DA0A (0: none)
comment    CODE:2DCA1 handler 6 of CODE:2DA0A: the record's dword +34h is a slot-16 counter; the current player's word +6 of it counted up, at the limit (word +4) its stream +48h to EVENT_QUEUE; then CODE:2DD8A
comment    CODE:2DD8A the counter's threshold actions (12 bytes from +50h): the one reached has its dword +4, an event stream, go to EVENT_QUEUE (at CODE:2DD75)
comment    CODE:2E5A2 handler 11h of CODE:2DA0A: the record's dword +34h is an event stream, to EVENT_QUEUE
name       CODE:2FE8E EVENT_QUEUE  ; [CODE:0000] into the ring of 64 dwords at [state+2A1Eh], the index state+2A1Ah
; how a mode starts (2026-09-29; run on table 1 with two -poke, see
; docs/HANDOFF.md, "A mode's track in a run")
comment    CODE:2C1DA each ball of the list at state+C1046h (state+C0D32h of them): its centre (words +12h, +14h, plus 8 each) against the zones at its dword +64h (14 bytes: x0, y0, x1, y1, a type, an object; -1 ends them; header slots 5 and 11 in table 1); inside one, the type through CODE:2C3DD. The ball's byte +0Ah marks the object while it is inside (type 4 in the object's byte +1, types 0 and 1 in byte +0), so a zone acts on entry, presumably (run: table 1's zone 3447h widened, its object's stream ran 0.56 s later)
comment    CODE:2E08C handler 15h of CODE:2DA0A: as handler 6 (CODE:2DCA1) without its end: the counter at +34h counted up for the current player, its word +16h too, then CODE:2DD8A (run, table 1: record 41E6h, counter 421Eh, at the ball's launch and in bursts; +16h back to 1 after 9 at CODE:2DF20)
comment    CODE:2E5B7 handler 16h of CODE:2DA0A: the counter at +34h's threshold action equal to the current player's word +16h: its stream (+4) to EVENT_QUEUE (table 1: record 4362h, lit by zone 352Fh's stream, taken by zone 3447h's; run with it forced: threshold 1, opcode 9, the mode stream's opcode 13h plays track 4)
comment    CODE:4FE8 plays track 33h (51) at the chooser's loading of infodata.mgl; not reached in runs up to t=126 (the chooser at t=7 plays no track)
; the other slot-15 handlers (2026-09-29, read from the code and the four
; modules' records; no run made for the handlers). "The player" is the
; record at state+0D76h (CODE:D8B8, player 1, in runs): its +8 a 12-digit
; packed-BCD number (high word +0, low dword +4) shown by display opcode
; 8, the score; its +10h another (high word +8, low dword +0Ch), the
; bonus (CODE:2BD95); byte +10h, byte +11h, word +12h, byte +14h below.
; The names checked in runs 2026-09-29 (table 1, docs/HANDOFF.md, "The
; player record in a run"): the takes raise +8 only; the bonus 12,345
; with word +12h 3 poked at a lost ball adds 37,035 to +8, the screen
; shows "BONUS 12,345", then "EXTRA BALL" for byte +10h 1
comment    CODE:2FBBF a take's points: [CODE:000C] points past a 12-digit packed-BCD number (high word at -8, low dword at -4), added to the player's +10h; the number 8 bytes before it added to the player's +8 (for a slot-15 record's +2Ch: +24h/+28h to +10h, +1Ch/+20h to +8; table 1 has records with both, e.g. 1000000 and 500000)
comment    CODE:2FD11 the 12-digit number [CODE:000C] points past added to the player's +8; CODE:2FDD3 the same to the player's +10h
comment    CODE:2BD95 at a lost ball (from CODE:2BBC6): the player's +10h number added to state+2AC8h/2ACCh once, or word +12h times when that is above 1, and that sum later to the player's +8 (after the call through state+2926h): the bonus times its multiplier (run: 12,345 x 3 in the score 2.0 to 2.2 s after the loss, between two dumps)
comment    CODE:2A4B1 the player's +10h number cleared unless byte +11h is set, word +12h cleared unless byte +14h is set; both bytes cleared: the bonus and its multiplier held for one ball (run: with both bytes FFh the bonus and the 3 stayed, the bytes 0)
comment    CODE:2BBC6 the player's byte +10h: not 0, one less and state+8Eh = 8 (after the text "EXTRA BALL" at CODE:2BBB2): extra balls (run: 1 poked, "EXTRA BALL" shown, GAME_PHASE 8 until the launch, the byte 0)
comment    CODE:2E2E1 handler 1 of CODE:2DA0A: the first light state of header slot 25 (state+290Ah) gets byte +5 FFh, the player's byte +10h one more: an extra ball (the records' +34h not read)
comment    CODE:2E31C handler 2 of CODE:2DA0A: byte +0 of [+34h] set to FFh when that is not 0 (table 2's one such record, 7402h, has 2 there, the next record's first word, so CODE:0002 is written, a scratch dword rewritten at once), the player's bit (CODE:003C, presumably) into byte +0 of the light state at +8, the player's byte +11h FFh (bonus held, CODE:2A4B1)
comment    CODE:2E6AB handler 3 of CODE:2DA0A: the player's +10h number added to its +8 (in no record of the four tables)
comment    CODE:2E43A handler 5 of CODE:2DA0A: the player's word +12h = the record's word +34h (2, 4, 6, 8, 0Ah in five records of tables 1, 2 and 4; 2..5 in four of table 3): the bonus multiplier, presumably
comment    CODE:2E6CC handler 7 of CODE:2DA0A: the slot-16 counter at +34h: its value (high word +38h, low dword +3Ch) added to the player's +8
comment    CODE:2E37F handler 8 of CODE:2DA0A: the player's byte +14h FFh (multiplier held, CODE:2A4B1; in table 1 only)
comment    CODE:2E2C0 handler 9 of CODE:2DA0A: the player's +8 added to itself (in no record)
comment    CODE:2E6EA handler 0Ah of CODE:2DA0A: the counter at +34h's value (as handler 7) added to the player's +8 as many times as the record's word +38h, or the current player's count (word +6) when that is less, and then that count set to 0; the count is not lowered otherwise (table 1's record 7C64h, the word 19h)
comment    CODE:2E13D handler 0Bh of CODE:2DA0A: the counter at +34h's value (+38h/+3Ch) raised by its step (high word +30h, low dword +34h; from +28h/+2Ch at CODE:2DF5C), then set to +40h/+44h when both dwords are at or above those and +40h is not negative: a cap, presumably
comment    CODE:2E29F handler 0Dh of CODE:2DA0A: the player's +10h added to itself (in no record)
comment    CODE:2E778 handler 0Eh of CODE:2DA0A: the counter at +34h's step (+30h/+34h) added to the player's +8
comment    CODE:2E45C handler 0Fh of CODE:2DA0A: the counter at +34h's step raised by the record's number at +38h/+3Ch (e.g. 5000000 in table 2's record 5F5Ah)
comment    CODE:2DC91 handler 10h of CODE:2DA0A: handlers 0Bh, 6 and 7 in turn
comment    CODE:2DC86 handler 12h of CODE:2DA0A: handlers 0Bh and 6 in turn
comment    CODE:2E796 handler 13h of CODE:2DA0A: [+34h] is a slot-26 BCD counter (so in all four tables): its current value (+2, +6) copied to its +22h, +26h and added to the player's +8
comment    CODE:2E7C8 handler 14h of CODE:2DA0A: the counter at +34h's word +26h = the record's word +38h times FRAME_RATE (state+50h) (5, 0Ah, 0Ch in the records; who reads +26h not looked at)
comment    CODE:2E21D handler 17h of CODE:2DA0A: while the mode stream waits with a timer (state+0D50h, 0D62h not negative) the timer set to the smaller of the record's words +34h and +36h times FRAME_RATE (state+50h); the timer plus +34h is computed (CODE:0024) and not used (table 3's record 75C4h: 5 and 1Eh, so 5 s)
comment    CODE:2E7FC handler 18h of CODE:2DA0A: the counter at +34h's words +6 and +16h of the current player one less, unless +6 is 0
comment    CODE:2E396 handler 19h of CODE:2DA0A: as handler 0Fh with DAS: the step lowered by the record's number (in no record)
comment    CODE:2E51D handler 1Ah of CODE:2DA0A: a number 0..FFh from the low byte of CODE:BAD4 (the counter display opcode 1Ah blinks by, CODE:2F7DE); [+34h] is a list of 8-byte entries (flags word, limit word, event stream): the first whose limit is above the number has its stream queued, unless its flag bit 0 is set and bit 1 set already (set here), then the number plus 5Dh again: a random award, each with bit 0 once (tables 2 and 4, 8 entries each, the last limit 100h)
comment    CODE:2E506 handler 1Bh of CODE:2DA0A: as handler 0Fh with the number past [+38h]+8 (in table 3 a slot-26 counter +2: its current value)

