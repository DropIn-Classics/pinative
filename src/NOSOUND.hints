; NOSOUND.SDR, the sound driver for no sound: a raw 32-bit image the main
; program loads through pMAX and calls at 0 (docs/audio-driver.md),
; unpacked from the archive in ILLUSION.EXE by tools/illfiles.py.
bin        build/files/NOSOUND.SDR
segment    CODE 0 CODE             ; the whole file, code and data

code       CODE:0933 DISPATCH      ; the jump at 0 goes here: the command in EAX through CMDS
words      CODE:09A4 13 CODE       ; commands 00h..12h (docs/audio-driver.md, the command ABI)
name       CODE:09A4 CMDS
code       CODE:09F0 CMD_INIT      ; command 0
code       CODE:0D2B CMD_LOAD_MODULE ; command 4: a module into slot BL from ES:EDX
code       CODE:10BB PORTS_SAVE    ; ports 61h, 21h, A1h to SAVED_61, SAVED_IMR1, SAVED_IMR2; IRQ_MASK1, IRQ_MASK2 FFh
name       CODE:2D4A SAVED_IMR1    ; port 21h at command 0 (run 2026-09-29: BAh)
name       CODE:2D4B SAVED_IMR2    ; port A1h (run: FFh)
name       CODE:2D4C SAVED_61      ; port 61h (run: 30h)
name       CODE:10DF IRQ_MASK1     ; the master PIC's mask the driver keeps (FFh: all masked)
name       CODE:10E0 IRQ_MASK2     ; the slave's
name       CODE:2D54 DRV_DS        ; DS at command 0, the driver's own block (run: 4); DISPATCH loads it for the other commands
name       CODE:2D56 HOST_CFG      ; EBX and ES at command 0: the configuration header (DRIVER_CFG); the selector at CODE:2D5A
name       CODE:2D5C HOST_CB_SEL   ; FS at command 0: the host callbacks' table; its offset (EDI) at HOST_CB_OFF
name       CODE:2D5E HOST_CB_OFF
name       CODE:2D62 INITED        ; FFh after command 0 (a second command 0 fails); cleared by command 0Bh
name       CODE:2D63 PLAYING       ; FFh after command 1 (the timer started, CODE:059A); MIX_UPDATE then mixes as far as SAMPLE_POS, else one tick a call
name       CODE:0D0D CMD11_PTR     ; a far pointer from command 11h (ES:EDX), FFFFFFFFh after command 0; the selector at CODE:0D11
code       CODE:137A CHAN_BUF_ALLOC ; 800h bytes by host callback 0, cleared, their selector to CHAN_BUF_SEL and to +0Ah of the four CHANNELS records
name       CODE:327C CHAN_BUF_SEL  ; run 2026-09-29: 2Ch
name       CODE:2C3A CHANNELS      ; C2C33 records of 3Bh bytes: +0 the tick routine, +4 the position's fraction (word), +6 the position, +0Ah the sample's selector, +0Ch the volume * 100h, +0Eh loop start, +10h loop end (1: none), +12h the end, +16h/+18h the step (integer, fraction) from the period, +1Ah the note * 2 + finetune (index into PERIOD_TAB), +1Ch..+22h arpeggio's steps, +24h volume slide, +26h the period, +28h the portamento's speed, +2Ah its target, +2Ch sample offset, +2Eh finetune * 48h, +30h..+32h vibrato position, speed, depth, +33h volume, +34h FFh after a vibrato row, +35h/+36h counters, +37h 1: a jingle's channel, +38h/+3Ah the pattern loop's row and count
code       CODE:06FD DEV_INIT      ; the device's part of command 0: for NOSOUND only BUFFERS_ALLOC
code       CODE:11C6 BUFFERS_ALLOC ; FRAME_BYTES = MIX_RATE / 50 and the sizes from it; DMA_ALLOC, VOLTAB_MAKE
name       CODE:326C MIX_RATE      ; AC44h (44100) in the file, not changed by command 0
name       CODE:3262 NBUF          ; 3 in the file; command 1 sets it from CX (2..0Fh)
name       CODE:326E FRAME_BYTES   ; MIX_RATE / 50 (run: 372h)
name       CODE:3270 FRAME_BYTES2  ; twice FRAME_BYTES (run: 6E4h)
name       CODE:3272 MIX_SIZE      ; FRAME_BYTES * NBUF (run: A56h)
name       CODE:3274 DMA_SIZE      ; FRAME_BYTES2 * NBUF (run: 14ACh)
code       CODE:1214 DMA_ALLOC     ; DMA_SIZE bytes by host callback 1, its linear base by callback 3; one that crosses a 64 KB line is freed, a filler up to the line allocated (DMA_FILLER_SEL), the buffer again, the filler freed; the buffer cleared, its selector to DMA_SEL and its base to DMA_LINEAR
name       CODE:325E DMA_SEL       ; run: 34h
name       CODE:3266 DMA_LINEAR    ; run: 13120h
name       CODE:21A0 DMA_FILLER_SEL ; also MOD_LOAD's scratch: the file's 4 bytes at 438h (its signature), later its song length and restart bytes
code       CODE:053D VOLTAB_MAKE   ; 8202h bytes by INT 92h AH=0Ah ("Volume table"), selector to VOLTAB_SEL: 41h rows of 100h words, row v entry b = (signed b) * v
name       CODE:327E VOLTAB_SEL    ; run: 3Ch
name       CODE:0956 RESULT        ; EAX a command returns through CODE:095A (CF clear) or CODE:0988 (CF set)
code       CODE:1C28 MOD_LOAD      ; command 4's work: the module file named at ES:EDX through host callbacks 6 (load), 9 (seek), 7 (read), 8 (unload) into the slot at SLOT_OFF; CF and LOAD_ERROR 1 (no memory), 2 (no file), 3 (a read failed)
name       CODE:2195 LOAD_ERROR    ; MOD_LOAD's error, command 4's EAX with CF
name       CODE:2196 MOD_HANDLE    ; BX after host callback 6 (the name's offset's low word: callback 6 leaves BX; the other callbacks do not read it)
name       CODE:2198 NOTE_IN       ; a pattern's 4-byte note as the file has it, for NOTE_CONVERT
name       CODE:219C NOTE_OUT      ; NOTE_CONVERT's result: the note's index in PERIODS + 1 (0 none), the sample, the effect, its parameter
name       CODE:21AC SAMPLE_HDRS_SIZE ; 3A2h (31 samples of 1Eh) for "M.K." or "FLT4" at 438h, else 1C2h (15)
name       CODE:21AE SIG_SIZE      ; 4 with a signature, else 0 (also: loop start and length in words, doubled)
name       CODE:21B0 NSAMPLES      ; 1Fh or 0Fh
name       CODE:21B2 NPATTERNS     ; PATTERNS_COUNT's: the highest pattern in the order list + 1
name       CODE:21B5 PAT_OFFSET    ; the next row's offset in PATTERNS_SEL's block: pattern * 400h + row * 10h (ROW_PLAY); MOD_LOAD: the first order's pattern * 400h
name       CODE:21B7 ORDER_POS     ; the position in ORDERS (a dword; ROW_PLAY moves it on, back to RESTART_POS at SONG_LENGTH); MOD_LOAD: 0
name       CODE:21C1 SAMPLE_HDRS   ; the file's sample headers (1Eh bytes each: name, length, finetune, volume, loop start, loop length; words big-endian)
name       CODE:2581 SONG_TITLE    ; the file's first 14h bytes
name       CODE:2C2D RESTART_POS   ; the file's restart byte AND 7Fh, 0 when not below the song length
name       CODE:2C2F SPEED         ; the ticks per row: 6 after MOD_LOAD, effect 0Fh sets it (MIX_UPDATE)
name       CODE:2D64 C2D64         ; cleared by command 4
name       CODE:2D67 SLOT_OFF      ; the slot command 4 (and others) works on, times 275h
name       CODE:2D73 SLOTS         ; module slots of 275h bytes: 1Fh sample records of 10h (+0 selector, +2 loop start, +4 loop end, +6 length, +8 volume, +0Ah length, +0Ch loop length, +0Eh finetune * 48h), then SLOT_LOADED, ORDERS, SONG_LENGTH, PATTERNS_SEL
name       CODE:2F63 SLOT_LOADED   ; + SLOT_OFF: FFh once command 4 has loaded (or tried) the slot; a second command 4 fails with EAX 0
name       CODE:2F64 ORDERS        ; + SLOT_OFF: the file's 80h-byte order list
name       CODE:2FE4 SONG_LENGTH   ; + SLOT_OFF: the file's song length (a word)
name       CODE:2FE6 PATTERNS_SEL  ; + SLOT_OFF: the patterns' block, NPATTERNS * 400h bytes by host callback 0, each note converted by NOTE_CONVERT
code       CODE:2595 NOTE_CONVERT  ; NOTE_IN to NOTE_OUT: the period (12 bits) looked up in PERIODS; one not there gives a note all 0
code       CODE:2614 PATTERNS_COUNT ; NPATTERNS from the slot's ORDERS (all 80h bytes, not only the song length's)
name       CODE:2ABD PERIODS       ; the periods NOTE_CONVERT looks up, words, 0 at the end

; the module player (command 6), read 2026-09-29
words      CODE:2B27 10 CODE       ; the effects at a row, by effect number (CODE:15E5, a channel's byte +37h not 1)
name       CODE:2B27 ROW_FX
words      CODE:2BA7 10 CODE       ; the same with byte +37h 1: only effects 0Bh, 0Dh, 0Eh, 0Fh
name       CODE:2BA7 ROW_FX_SFX
code       CODE:0658 TIMER_IRQ     ; IRQ 0's handler, set by CODE:059A through host callback 1Eh (EDX 658h): SAMPLE_POS counted, wrapped at MIX_SIZE; at TIMER_COUNT 0 VSYNC_TICK (CODE:08A4)
name       CODE:06A8 SAMPLE_POS    ; TIMER_IRQ's count, 0 at command 1 (CODE:059A); CODE:0651 reads it
words      CODE:2B67 10 CODE       ; effect 0Eh (CODE:1965) by the parameter's high nibble
name       CODE:2B67 ROW_FX_E
words      CODE:2BE7 10 CODE       ; the same with byte +37h 1: only 6 and 0Eh
name       CODE:2BE7 ROW_FX_E_SFX
; a channel's dword +0 (CHANNELS): the routine CODE:14FC calls each tick; the effects set it
code       CODE:16DA
code       CODE:178E
code       CODE:1824
code       CODE:188A
code       CODE:18CF
code       CODE:19E9
code       CODE:1A26
code       CODE:1A4B
code       CODE:1B9E
ptr        CODE:1627 CODE
ptr        CODE:16D3 CODE
ptr        CODE:170C CODE
ptr        CODE:1721 CODE
ptr        CODE:1787 CODE
ptr        CODE:181D CODE
ptr        CODE:1882 CODE
ptr        CODE:18AF CODE
ptr        CODE:1987 CODE
ptr        CODE:199B CODE
ptr        CODE:19E2 CODE
ptr        CODE:1A1F CODE
ptr        CODE:1A37 CODE
ptr        CODE:1A44 CODE
ptr        CODE:1A50 CODE
; the mixer (CODE:00E4) calls per channel the routine of MIX_ROUTINES
words      CODE:00C0 4 CODE stride=8 ; dword +0 of four 8-byte entries, one per channel; dword +4 an offset into the buffer (0 for all four)
name       CODE:00C0 MIX_ROUTINES
code       CODE:0249 MIX_SET       ; channel 0: ECX samples from FS:ESI (fraction in EBP, step EDX:BP) through the volume row EAX of GS to words ES:EDI, stored
code       CODE:03C3 MIX_ADD       ; channels 1-3: as MIX_SET, added to the words there
words      CODE:0268 10 CODE       ; MIX_SET's entries into its 16 unrolled steps (for the ECX AND 0Fh left over)
words      CODE:03E2 10 CODE       ; MIX_ADD's
; the player (command 6), names 2026-09-29
code       CODE:0D9F CMD_MIX       ; command 6: MIX_UPDATE; then with C2D66 FFh the far pointer of command 11h called
code       CODE:0651 SAMPLE_POS_GET ; ECX = SAMPLE_POS
code       CODE:1A7B MIX_ROOM      ; CX = SAMPLE_POS less MIX_POS, round MIX_SIZE: what the timer has played past the mixing
code       CODE:1A98 MIX_UPDATE    ; mixes FRAME_BYTES (PLAYING 0) or MIX_ROOM's, at most FRAME_BYTES, in pieces that end at a tick's (FRAME_BYTES) line; at each line TICKS counted and the module's tick played (TICK_FX, or ROW_PLAY every SPEED ticks)
code       CODE:00E4 MIX           ; MIX_LEN samples of each channel at MIX_POS through MIX_ROUTINES; a channel past its end loops or stops, a jingle's channel gets the music's state back from C2D26..
name       CODE:326A MIX_POS       ; where the mixing is in the buffer, in samples (words), below MIX_SIZE
name       CODE:3276 MIX_LEN       ; MIX_UPDATE's piece
name       CODE:3278 MIX_LEFT      ; MIX_UPDATE's samples still to mix
name       CODE:3264 MASTER_VOL    ; command 0Ch's BX, at most 100h: the channels' volumes times it over 10000h (not the jingle's channels)
name       CODE:2C33 NCHANNELS     ; a word
name       CODE:2C36 TICKS         ; the ticks played since command 1 (L0C39 clears it); command 0Dh returns it less the ticks still in the buffer
name       CODE:2C31 TICK_COUNT    ; down to the next row
name       CODE:2C32 STOPPED       ; 1 by effect 0Fh with 0: no rows, no ticks' effects
name       CODE:2C30 SAVED_SPEED   ; SONG_RESTORE's SPEED
name       CODE:2C27 PAT_DELAY     ; effect 0EEh's rows to wait
name       CODE:2C28 BREAK_ROW     ; 0, or the row to start the next order at + 1 (effects 0Bh, 0Dh)
name       CODE:2C29 CUR_PATTERN   ; ORDERS' byte at ORDER_POS
name       CODE:2C35 ROW_SAMPLE    ; the sample of the note being played (effect 9)
name       CODE:21B3 LOOP_TO       ; FFFFh, or PAT_OFFSET to go back to (effect 0E6h)
name       CODE:2D65 SONG_END      ; FFh by effect 0Bh jumping to the order it is at with C2D64 FFh: SONG_RESTORE at the next row
name       CODE:2D66 SONG_END_CB   ; FFh with SONG_END: command 6 then calls command 11h's pointer
name       CODE:2D6B SAVED_SLOT    ; SONG_RESTORE's SLOT_OFF, PAT_OFFSET (C21BB) and ORDER_POS (C21BD)
name       CODE:2B07 SINE_TAB      ; 32 bytes, vibrato's
name       CODE:263D PERIOD_TAB    ; words: the periods by note * 2 + finetune * 48h
code       CODE:1019 SONG_RESTORE  ; SONG_END's work: SAVED_SLOT's slot and positions, SAVED_SPEED, CHANNELS_RESET
code       CODE:1057 CHANNELS_RESET ; the channels not a jingle's (all when not PLAYING) silenced; BREAK_ROW 0
code       CODE:13DA ROW_PLAY      ; the row at PAT_OFFSET (NOTE_PLAY per channel), then PAT_OFFSET on: LOOP_TO, or the next row, or the next order (BREAK_ROW)
code       CODE:14DC NOTE_PLAY     ; CX, DX a channel's note (CL note, CH sample, DL effect, DH parameter): NOTE_SAMPLE and NOTE_PERIOD but for effects 3, 5 and a jingle's channel, then NOTE_FX
code       CODE:14FC TICK_FX       ; each channel's routine at +0
code       CODE:1512 NOTE_PERIOD   ; the note's period and step, the position to the sample offset
code       CODE:156A NOTE_SAMPLE   ; the sample's selector, volume, finetune, loop
code       CODE:15E5 NOTE_FX       ; the step again after a vibrato row; the tick routine RET (CODE:1B9E); the effect through ROW_FX or ROW_FX_SFX
name       CODE:2D6F NEXT_SLOT     ; the slot times 275h commands 8 and 0Ah (CODE:0F17, 0FBE) start at; effects 0Bh and 0Dh set it to SLOT_OFF
code       CODE:0B31 CMD_PLAY      ; command 1: PLAYING, TICKS 0, NBUF from CX (NBUF_SET), MIX_UPDATE NBUF times (nothing mixed: SAMPLE_POS 0), TIMER_START
code       CODE:0C5B CMD_PAUSE     ; command 2, a toggle (PAUSED): pause (CODE:1167: the PIC's masks kept in PAUSE_IMR1, PAUSE_IMR2, command 0's SAVED_IMR1/2 put back; CODE:0604: IRQ 0 masked) or resume (CODE:1184: the kept masks back); refused unless PLAYING. Run 2026-09-30 (table 1, GAME_PHASE 6's MUSIC_REQUEST, t=150.0168): called twice in a row, PAUSED 0 after, PAUSE_IMR1 FCh, PAUSE_IMR2 FFh
name       CODE:0C85 PAUSED
name       CODE:1193 PAUSE_IMR1
name       CODE:1194 PAUSE_IMR2
code       CODE:0B96 NBUF_SET      ; NBUF from CX (2..0Fh); for another NBUF MIX_SIZE, DMA_SIZE and the DMA buffer made again (host callback 2, DMA_ALLOC)
code       CODE:0CB9 CMD_LEVEL     ; command 0Ch: MASTER_VOL = BX, at most 100h
code       CODE:0CD0 CMD_POSITION  ; command 0Dh: EAX = TICKS - (NBUF - MIX_ROOM / FRAME_BYTES), the ticks played
code       CODE:0E2A CMD_SFX       ; command 9: a sound on channel DL (1..): the channel's music state kept in C2D26.. unless +37h is set (CODE:0EB4), FS:ESI to ESI+ECX its sample, no loop, the step for note BL (PERIOD_TAB), NOTE_FX with effect 0Ch (volume BH), +37h 1
code       CODE:0D13 CMD_SFX_BUSY  ; command 12h: EAX the byte +37h of channel DL (1 while a sound of command 9 plays)
code       CODE:059A TIMER_START   ; SAMPLE_POS 0; IRQ 0's vector (host callback 4, kept at OLD_IRQ0) set to TIMER_IRQ (callback 5); the PIT (CODE:06D2); IRQ 0 unmasked (CODE:10FC)
code       CODE:06D2 PIT_SET       ; PIT channel 0 mode 3 with 1234DCh / MIX_RATE (PIT_DIV)
name       CODE:327A PIT_DIV       ; run 2026-09-29: 1Bh (27: IRQ 0 at 44192 Hz)
name       CODE:06AC TIMER_COUNT   ; a word TIMER_IRQ counts down; at 0 command 0Eh's retrace callback (CODE:08A4) when CODE:0799 is FFh
name       CODE:2D44 OLD_IRQ0      ; IRQ 0's vector before TIMER_START (offset, selector at +4; run: 0030:0000414B)
code       CODE:0C86 CMD_STOP      ; command 3 (refused when not PLAYING): PLAYING 0, TIMER_STOP, CHANNELS_RESET, command 0Eh's callbacks taken back (CODE:079A), ports 61h, 21h, A1h and the PIT as command 0 found them (PORTS_RESTORE)
code       CODE:0618 TIMER_STOP    ; the PIT's channel 0 to divisor 0 (PIT_RESET, 18.2 Hz), IRQ 0's vector back from OLD_IRQ0 (callback 5), the PIC's masks back (CODE:114A: IRQ_MASK1 FDh, IRQ_MASK2 FFh)
code       CODE:1367 PIT_RESET     ; PIT channel 0 mode 3 with divisor 0
code       CODE:10E1 PORTS_RESTORE ; SAVED_61, SAVED_IMR1, SAVED_IMR2 to ports 61h, 21h, A1h; PIT_RESET
code       CODE:0F17 CMD_ORDER     ; command 8: slot CL's module from its order BL (ORDER_POS, CUR_PATTERN, PAT_OFFSET, SPEED 6); with C2D64 FFh (set by command 0Ah, a jingle playing presumably) only kept for the music's return (SAVED_SLOT, C21BB, C21BD, SAVED_SPEED)
; the retrace callbacks (commands 0Eh, 0Fh), read 2026-09-30 for the chooser (CODE:4CB6 of ILLUSION.386)
code       CODE:0731 CMD_VSYNC     ; command 0Eh: ES:EDX to VSYNC_CB, FRAME_MEASURE, VSYNC_ON FFh
code       CODE:074F CMD_VSYNC2    ; command 0Fh: ES:EDX to VSYNC2_CB, VS2_TICKS = CX * VS_DISPLAY / 10000h + VS_RETRACE, VS2_IRQS from it, VSYNC2_ON FFh
code       CODE:079A VSYNC_OFF     ; with VSYNC_ON: both callbacks set to the RETF at CODE:0798, VSYNC2_ON and VSYNC_ON 0 (CMD_STOP)
code       CODE:07D6 FRAME_MEASURE ; a retrace's start waited for, the PIT's channel 0 in mode 0 from 0; VS_RETRACE at the first read with the display on after the retrace, the last such read before the next retrace less that VS_DISPLAY, that retrace VS_FRAME; VS_FRAME97 = VS_FRAME * F851h / 10000h (97 %), VS_IRQS from it
code       CODE:0887 TICKS_TO_IRQS ; AX PIT ticks to IRQs at MIX_RATE: (AX * MIX_RATE + 91A6Eh) / 1234DCh
code       CODE:08A4 VSYNC_TICK    ; TIMER_IRQ's at TIMER_COUNT 0 with VSYNC_ON: VSYNC_PHASE toggled; to 0 with VSYNC2_ON: TIMER_COUNT VS_IRQS - VS2_IRQS and VSYNC2_CB called; else (interrupts on) the retrace waited for, TIMER_COUNT VS2_IRQS (VS_IRQS without VSYNC2_ON) and VSYNC_CB called. So VSYNC_CB at each retrace, VSYNC2_CB VS2_TICKS after it
name       CODE:0723 VS_RETRACE    ; PIT ticks from a retrace's start to the display (run 2026-09-30, the chooser's mode: BDh)
name       CODE:0725 VS_DISPLAY    ; PIT ticks of the display (run: 4D76h)
name       CODE:0727 VS_FRAME      ; PIT ticks from a retrace's start to the next (run: 4E35h)
name       CODE:0729 VS_FRAME97    ; VS_FRAME * F851h / 10000h (run: 4BDCh)
name       CODE:072B VS2_TICKS     ; command 0Fh's PIT ticks after a retrace's start (run, CX 1999h: 87Bh)
name       CODE:072D VS_IRQS       ; VS_FRAME97 in IRQs (run: 2CEh)
name       CODE:072F VS2_IRQS      ; VS2_TICKS in IRQs (run: 50h)
name       CODE:0791 VSYNC2_ON     ; FFh after command 0Fh
name       CODE:0797 VSYNC_PHASE   ; VSYNC_TICK's toggle: 1 while the retrace is waited for next
name       CODE:0799 VSYNC_ON      ; FFh after command 0Eh
name       CODE:2D38 VSYNC_CB      ; command 0Eh's far pointer (offset, selector at +4)
name       CODE:2D3E VSYNC2_CB     ; command 0Fh's far pointer (offset, selector at +4)
