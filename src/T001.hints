; SOURCE\T001.BPC, table 1's module: code and data the main program loads
; anywhere and relocates by adding its base to every dword T001.REL lists
; (docs/bpc-module.md), unpacked from the archive in ILLUSION.EXE by
; tools/illfiles.py. The list says exactly where the offsets are
; (doskit's `offrel`); the header's resource slots carry flags in their
; top two bits. Nothing is entered at 0: the main program calls the
; module through the header's pointers.
bin        build/files/SOURCE/T001.BPC noentry
offrel     build/files/SOURCE/T001.REL flags=C0000000
segment    CODE 0 CODE             ; the whole file, code and data

name       CODE:0000 HEADER        ; 45 dword slots, copied relocated to the main program's CODE:F3E4 (docs/bpc-module.md)
words      CODE:0080 1 CODE        ; slot 32
words      CODE:009C 3 CODE        ; slots 39..41
code       CODE:37AD MOD_BALL_BONUS ; slot 32: the end-of-ball bonus (docs/bpc-module.md, "Audio-control records"; not checked here)
code       CODE:00B4 MOD_LOADED    ; slot 39: called once the module is loaded and its resources resolved (main program CODE:B287); a RET
code       CODE:00B5 MOD_GAME_START ; slot 40: called at a game's start (main program CODE:2AA6D); a RET in table 1
code       CODE:00B6 MOD_NEXT_BALL ; slot 41: called at the next player's ball (main program CODE:2BD61)
comment    CODE:00A8 slot 42: 0, and relocated (in T001.REL): the module's base once loaded

; instructions tasm.py has no source form for, written as DB: a 16-bit
; address with no register (67h; the main program's cells at DS:0..3Fh)
; and one DS override the source would drop (CODE:394C)
raw        CODE:00B6
raw        CODE:00C1
raw        CODE:00CA
raw        CODE:00D4
raw        CODE:00DC
raw        CODE:00E4
raw        CODE:00F2
raw        CODE:00FB
