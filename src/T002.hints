; SOURCE\T002.BPC, table 2's module: code and data the main program loads
; anywhere and relocates by adding its base to every dword T002.REL lists
; (docs/bpc-module.md), unpacked from the archive in ILLUSION.EXE by
; tools/illfiles.py. The list says exactly where the offsets are
; (doskit's `offrel`); the header's resource slots carry flags in their
; top two bits. Nothing is entered at 0: the main program calls the
; module through the header's pointers. Made as src/T001.hints.
bin        build/files/SOURCE/T002.BPC noentry
offrel     build/files/SOURCE/T002.REL flags=C0000000
segment    CODE 0 CODE             ; the whole file, code and data

name       CODE:0000 HEADER        ; 45 dword slots, copied relocated to the main program's CODE:F3E4 (docs/bpc-module.md)
words      CODE:0080 1 CODE        ; slot 32
words      CODE:009C 3 CODE        ; slots 39..41
code       CODE:381D MOD_BALL_BONUS ; slot 32: the end-of-ball bonus (docs/bpc-module.md): the audio record to host +04h; the player's bonus shown over eight rounds of "BONUS" (every other round the multiplier's text record, by the player's word +12h n/2 - 1), the combos (none: the count is 0), then "TOTAL BONUS" and the total (the number ending at state+2AC8h) or "NO BONUS"; in C in port/src/modcode.c, one routine for the four tables (docs/HANDOFF.md, "GAME_PHASE 5 in the port"); not run (table 2 stops at GAME_START)
code       CODE:00B4 MOD_LOADED    ; slot 39: called once the module is loaded (main program CODE:B287)
code       CODE:00B5 MOD_GAME_START ; slot 40: called at a game's start (main program CODE:2AA6D): TUNES_RESET; in C in port/src/modcode.c (T2_TUNES_RESET), compared 2026-10-01
code       CODE:00BB MOD_NEXT_BALL ; slot 41: called at the next player's ball (main program CODE:2BD61): the lamps of the list at 994Ah relit by the player's word +12h (the bonus multiplier, presumably), then TUNE_COPY
comment    CODE:00A8 slot 42: 0, and relocated: the module's base once loaded

; the opcode-14h object of mode stream 92BEh (command 92DEh), table 2's
; music chooser (docs/bpc-module.md, "Table 2's music chooser"): two
; methods the main program calls (CODE:2DBAD, CODE:2CFC8)
name       CODE:9A08 TUNE_OBJECT
words      CODE:9A08 2 CODE
code       CODE:9A10 TUNE_START    ; the object's +0: the player's choice 0, the timers, state+0F1h cleared
code       CODE:9B68 TUNE_UPDATE   ; the object's +4: the left flipper, the name, Enter
name       CODE:9ADA TUNES_RESET   ; all eight players' choices 0, template 0 copied over records 0..2
name       CODE:9A55 TUNE_COPY     ; the current player's template (three audio records) over records 0..2
name       CODE:9D4E TUNE_PIC      ; picture ECX+1 of the table at FS:0, 160 x 16, to the display at ES:0, 0FCh added to each byte; ES and FS from host vector +28h
name       CODE:9D88 TUNE_CHOICES  ; a word per player (state+0D72h), the tune 0..2; the chooser's timers after them
name       CODE:9D9E TUNE_TEMPLATES ; three pointers to the templates, records 3..5, 6..8, 9..11
name       CODE:9DAA TUNE_NAMES    ; three pointers to the names' text records
